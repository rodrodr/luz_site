---
/**
 * F25 · Siete fechas corregidas (Versiones, #fechas). Plan § F25 y anexo V28 (`FigLinea`).
 * Una línea por sesión sobre el mismo eje de tiempo: el aro es la fecha que daba la V1 (la errónea, sin relleno: lo que
 * no era) y el punto, la fecha corregida en la V2; la flecha va de una a otra y, a la derecha, cuántos días se movió.
 * Dos anotaciones como mucho, las que el dato sostiene: la fecha que salía de la portada del tomo y la sesión que cambia
 * también de legislatura. La prueba de cada sesión va en su nota (teclado, puntero, toque) y en la Tabla.
 * Datos: `src/data/fechas_corregidas.json` (erratas_fechas_V1.csv + la comparación V1 ↔ V2). Copy: `fig.F25.*`.
 */
import FiguraMarco from '../FiguraMarco.astro';
import { t, plano, plantillaNota, existe } from '../../lib/i18n';
import { fmt, marcaPendiente } from '../../lib/cifras';
import { dato } from '../../lib/datos';
import { tiempo, anosQueCubren, pct } from '../../viz/geom/escalas';
import type { Lang } from '../../lib/idiomas';

interface S { sesion: number; leg_v1: string; leg_v2: string; fecha_v1: string; fecha_v2: string; dias: number; id_min: number; id_max: number; filas: number; prueba: string[]; clave: string }
interface Props { lang: Lang }
const { lang } = Astro.props;
const D = dato<{ sesiones: S[]; extremos: [string, string] }>('fechas_corregidas');
const L = D?.sesiones ?? [];
const o = (k: string, ctx = {}) => (existe(k) ? t(lang, k, ctx) : marcaPendiente(k, 'copy'));
const marco = anosQueCubren(D?.extremos[0] ?? '1931-07-01', D?.extremos[1] ?? '1934-06-30', 6);
const x = tiempo(marco.desde, marco.hasta);
const idF = (s: S, que: string, v: number) => fmt.dato(v, fmt.id(v, lang), `fig.F25.s${s.sesion}.${que}`, 'V2');
const fecha = (iso: string) => `<time datetime="${iso}">${fmt.fechaCorta(iso)}</time>`;
const prueba = (s: S) => [
  ...s.prueba.map((p) => plano(lang, `fig.F25.prueba.${p}`)),
  ...(s.leg_v1 !== s.leg_v2 ? [plano(lang, 'fig.F25.nota.legislatura', { vars: { leg_v1: s.leg_v1, leg_v2: s.leg_v2 } })] : []),
].join(' ');
const diasHtml = (s: S) => {
  const signo = s.dias > 0 ? '+' : '−';
  return o('fig.F25.dias', { vars: { dias: signo + fmt.dato(Math.abs(s.dias), fmt.n(Math.abs(s.dias), lang), `fig.F25.s${s.sesion}.dias`, 'V2') } });
};
// Las anotaciones editoriales (DESIGN.md: tres como mucho): solo donde la prueba explica un salto que se ve.
const anota = (s: S) => (s.prueba.includes('portada') ? o('fig.F25.prueba.portada')
  : s.leg_v1 !== s.leg_v2 ? o('fig.F25.nota.legislatura', { vars: { leg_v1: `<span class="nw">${s.leg_v1}</span>`, leg_v2: `<span class="nw">${s.leg_v2}</span>` } }) : '');
const pT = plantillaNota(lang, 'fig.F25.nota', ['num', 'fecha_v1', 'fecha_v2']);
const pD = plantillaNota(lang, 'fig.F25.nota.cifras', ['filas', 'ids']);
---
<FiguraMarco lang={lang} id="F25" plantillaT={pT} plantilla={pD} plantillaB="{prueba}">
  <div slot="grafico" class="linea">
    <ul class="leyenda" role="list">
      <li><span class="aro" aria-hidden="true"></span><Fragment set:html={o('fig.F25.leyenda.v1')} /></li>
      <li><span class="punto" aria-hidden="true"></span><Fragment set:html={o('fig.F25.leyenda.v2')} /></li>
    </ul>
    <div class="plano">
      <div class="anos" aria-hidden="true">
        {marco.anos.map((a) => <span style={`--x: ${pct(x(`${a}-01-01`))}`}><time datetime={String(a)}>{a}</time></span>)}
      </div>
      <ol class="sesiones" role="list" data-recorre tabindex="0" aria-label={plano(lang, 'fig.F25.pregunta')} aria-describedby="fechas-teclado">
        {L.map((s) => {
          const a = x(s.fecha_v1), b = x(s.fecha_v2);
          const izq = Math.min(a, b), ancho = Math.abs(b - a);
          return (
            <li class="ses" data-paso data-nota
              data-v-num={String(s.sesion)} data-v-fecha_v1={fmt.fechaCorta(s.fecha_v1)} data-v-fecha_v2={fmt.fechaCorta(s.fecha_v2)}
              data-v-filas={fmt.n(s.filas, lang)} data-v-ids={`${s.id_min}–${s.id_max}`} data-v-prueba={prueba(s)}>
              <span class="rotulo">
                <span class="num"><Fragment set:html={o('fig.F25.tabla.col.sesion')} /> <Fragment set:html={idF(s, 'num', s.sesion)} /></span>
                <span class="leg">{s.leg_v1 !== s.leg_v2 ? `${s.leg_v1} → ${s.leg_v2}` : s.leg_v2}</span>
              </span>
              <span class="carril">
                {ancho > 0 && <span class:list={['astil', { atras: b < a, corto: ancho < 1.6 }]} style={`--a: ${pct(izq)}; --w: ${pct(ancho)}`} />}
                <span class="aro" style={`--x: ${pct(a)}`} />
                <span class="punto" style={`--x: ${pct(b)}`} />
              </span>
              <span class="dias" set:html={diasHtml(s)} />
              {anota(s) && <span class="anota"><span class="trazo" aria-hidden="true"></span><span set:html={anota(s)} /></span>}
            </li>
          );
        })}
      </ol>
    </div>
    <p class="eje nota" set:html={o('fig.F25.eje')} />
  </div>
  <div slot="tabla">
    <div class="fig-desliza" tabindex="0" role="region" aria-labelledby="fechas-caption">
      <table class="fig-tabla">
        <caption id="fechas-caption"><span class="fig-rotulo-tabla" set:html={o('fig.F25.titulo')} /></caption>
        <thead>
          <tr>
            <th scope="col" set:html={o('fig.F25.tabla.col.sesion')} />
            <th scope="col" set:html={o('fig.F25.tabla.col.v1')} />
            <th scope="col" set:html={o('fig.F25.tabla.col.v2')} />
            <th scope="col" class="num" set:html={o('fig.F25.tabla.col.filas')} />
            <th scope="col" set:html={o('fig.F25.tabla.col.ids')} />
            <th scope="col" set:html={o('fig.F25.tabla.col.prueba')} />
          </tr>
        </thead>
        <tbody>
          {L.map((s) => (
            <tr>
              <th scope="row"><Fragment set:html={idF(s, 'num', s.sesion)} /> <span class="leg-t">{s.leg_v1 !== s.leg_v2 ? `${s.leg_v1} → ${s.leg_v2}` : s.leg_v2}</span></th>
              <td set:html={fecha(s.fecha_v1)} />
              <td set:html={fecha(s.fecha_v2)} />
              <td class="num" set:html={fmt.dato(s.filas, fmt.n(s.filas, lang), `fig.F25.s${s.sesion}.filas`, 'V2')} />
              <td><Fragment set:html={idF(s, 'desde', s.id_min)} />–<Fragment set:html={idF(s, 'hasta', s.id_max)} /></td>
              <td class="prueba">{prueba(s)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</FiguraMarco>

<style>
  .leyenda { list-style: none; margin: 0 0 var(--e5); padding: 0; display: flex; flex-wrap: wrap; gap: .5rem 1.6rem; font-size: var(--fs-small); color: var(--ink-2); }
  .leyenda li { display: inline-flex; align-items: center; gap: .55rem; }
  .leyenda .aro, .leyenda .punto { position: static; transform: none; }
  .plano { position: relative; --rot: 10rem; --dia: 6.5rem; padding-top: 1.7rem; }
  .anos { position: absolute; top: 0; bottom: 0; left: 0; right: 0; pointer-events: none; }
  .anos span { position: absolute; left: var(--x); top: 0; bottom: 0; border-left: 1px solid var(--hair); font: 400 var(--fs-mono-s)/1 var(--mono); color: var(--mute); }
  .anos time { position: absolute; top: .1rem; left: .35rem; }
  .sesiones { list-style: none; margin: 0; padding: 0; display: grid; gap: .2rem; position: relative; }
  .ses {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: 'rotulo dias' 'carril carril' 'anota anota';
    gap: .15rem 1rem; align-items: center; padding: .55rem 0; border-bottom: 1px solid var(--hair);
  }
  .ses:global(.fig-activa) { outline: none; }
  .ses:global(.fig-activa) .punto { outline: 2px solid var(--ink); outline-offset: 2px; }
  .ses:global(.fig-activa) .num { text-decoration: underline 2px var(--accent); text-underline-offset: .2em; }
  .rotulo { grid-area: rotulo; display: flex; flex-wrap: wrap; gap: .1rem .6rem; align-items: baseline; }
  .num { font-size: var(--fs-small); color: var(--ink); }
  .leg, .leg-t { font: 400 var(--fs-mono-s)/1.3 var(--mono); color: var(--mute); white-space: nowrap; }
  .dias { grid-area: dias; font: 500 .8rem/1.2 var(--mono); color: var(--ink); text-align: right; white-space: nowrap; }
  .carril { grid-area: carril; position: relative; height: 1.5rem; }
  .aro, .punto { position: absolute; top: 50%; left: var(--x); transform: translate(-50%, -50%); border-radius: 50%; display: inline-block; }
  /* La fecha errónea no se rellena: es lo que no era. La corregida, en la tinta de los datos. */
  .aro { width: .8rem; height: .8rem; border: 1.5px solid var(--ausencia-trazo); background: var(--bg); }
  .punto { width: .55rem; height: .55rem; background: var(--dato-2); }
  .astil { position: absolute; top: 50%; left: var(--a); width: var(--w); border-top: 1.5px solid var(--ink-2); }
  .astil::after {
    content: ''; position: absolute; right: -1px; top: -5px; width: 8px; height: 8px; background: var(--ink-2);
    clip-path: polygon(0 0, 100% 50%, 0 100%); transform: translateY(-.75px);
  }
  .astil.atras::after { right: auto; left: -1px; clip-path: polygon(100% 0, 0 50%, 100% 100%); }
  .astil.corto::after { display: none; }
  .anota { grid-area: anota; display: flex; gap: .5rem; align-items: baseline; font-size: var(--fs-small); color: var(--ink-2); line-height: 1.45; padding-top: .2rem; max-width: 40rem; }
  .trazo { flex: none; width: .9rem; border-top: 1.5px solid var(--accent); transform: translateY(-.3em); }
  .eje { margin: .6rem 0 0; }
  .anota :global(.nw) { white-space: nowrap; }
  .prueba { font-family: var(--text); font-size: var(--fs-small); min-width: 22rem; white-space: normal; }
  @media (min-width: 48rem) {
    .ses { grid-template-columns: var(--rot) minmax(0, 1fr) var(--dia); grid-template-areas: 'rotulo carril dias' '. anota .'; }
    .anos { left: calc(var(--rot) + 1rem); right: calc(var(--dia) + 1rem); }
    .rotulo { flex-direction: column; gap: 0; }
  }
  @media (max-width: 47.99rem) {
    /* En el móvil el carril va a todo el ancho y los años se leen encima. */
    .anos { top: 0; }
  }
</style>
