---
/**
 * F35 · Qué base usa cada figura (Versiones, #bases). Plan § F35: tabla GENERADA del registro `lib/figuras.ts` y del
 * sello del exportador (`src/data/sello.json`); no puede decir otra cosa que el LÉAME y la cita de cada figura. No
 * lleva salvedad: es la salvedad de todas. Las huellas completas van una sola vez, arriba, por base; en la tabla, el
 * sello de la base y el principio de su huella. La fecha de cálculo es la de la exportación, la misma para todas.
 * Copy: `fig.F35.*` (versiones.md). Sustituye a `TablaFiguras.astro`, cuyas claves no casaban con el copy (P1-5).
 */
import Sello from '../Sello.astro';
import { t, existe } from '../../lib/i18n';
import { marcaPendiente } from '../../lib/cifras';
import { FIGURAS, rutaDatos } from '../../lib/figuras';
import { sello } from '../../lib/datos';
import { url, recurso, ETAPAS, PUERTAS_PUBLICADAS, EDICION, PAGINAS } from '../../lib/rutas';
import type { Base } from '../../lib/cifras';
import type { Lang } from '../../lib/idiomas';

interface Props { lang: Lang }
const { lang } = Astro.props;
const o = (k: string) => (existe(k) ? t(lang, k) : marcaPendiente(k, 'copy'));
const s = sello();
const filas = FIGURAS.filter((f) => f.ed <= EDICION && f.id !== 'H');
const primera = (ruta: string) => ruta.replace('<etapa>', ETAPAS[0].slug).replace('<puerta>', PUERTAS_PUBLICADAS[0].slug);
// Nombre de la página de cada figura: una clave por plantilla (`fig.F35.pagina.<x>`).
const PAG: Record<string, string> = Object.fromEntries(Object.entries(PAGINAS).map(([k, v]) => [v, k]));
const pagina = (ruta: string) => ruta === 'cortes/<etapa>' ? 'etapa' : ruta === 'cortes/sesiones/<puerta>' ? 'puerta' : PAG[ruta] ?? 'inicio';
const HUELLA: Partial<Record<Base, string | undefined>> = {
  V2: s?.v2_md5 as string | undefined, v3: s?.v3_sha256 as string | undefined, proyecto: s?.proyecto_sha256 as string | undefined,
  afin: s ? `${s.afin_version} · ${s.afin_unf}` : undefined, croquis: s?.hemiciclo_sha256 as string | undefined,
};
const bases = [...new Set(filas.flatMap((f) => f.base))].filter((b) => b in HUELLA) as Base[];
const corta = (b: Base) => (HUELLA[b] ? (b === 'afin' ? String(s?.afin_version) : String(HUELLA[b]).slice(0, 8)) : null);
const fecha = s?.exportado ? String(s.exportado).slice(0, 10) : null;
---
<div class="bases" id="bases">
  <p class="asiento" id="bases-huellas" set:html={o('fig.F35.huellas.titulo')} />
  <dl class="huellas" aria-labelledby="bases-huellas">
    {bases.map((b) => (
      <div>
        <dt><Sello lang={lang} base={b} /> <span class="que" set:html={o(`fig.F35.huella.${b}`)} /></dt>
        <dd>{HUELLA[b] ? <code>{HUELLA[b]}</code> : <Fragment set:html={marcaPendiente('sello.json')} />}</dd>
      </div>
    ))}
    <div>
      <dt><span class="que" set:html={o('fig.F35.tabla.col.fecha')} /></dt>
      <dd>{fecha ? <time datetime={fecha}>{fecha}</time> : <Fragment set:html={marcaPendiente('sello.exportado')} />}</dd>
    </div>
  </dl>
  <div class="fig-desliza" tabindex="0" role="region" aria-labelledby="bases-caption">
    <table class="fig-tabla tabla-bases" data-figura="F35">
      <caption id="bases-caption" class="sr-only" set:html={o('fig.F35.titulo')} />
      <thead>
        <tr>
          <th scope="col" set:html={o('fig.F35.tabla.col.figura')} />
          <th scope="col" set:html={o('fig.F35.tabla.col.pagina')} />
          <th scope="col" set:html={o('fig.F35.tabla.col.base')} />
          <th scope="col" set:html={o('fig.F35.tabla.col.huella')} />
          <th scope="col" set:html={o('fig.F35.tabla.col.archivo')} />
        </tr>
      </thead>
      <tbody>
        {filas.map((f) => (
          <tr>
            <th scope="row"><span class="fid" data-audit-exento="código de figura del registro">{f.id}</span> <a href={url(lang, `${primera(f.ruta)}#${f.ancla}`)} set:html={o(`${f.familia}.titulo`)} /></th>
            <td class="pag" set:html={o(`fig.F35.pagina.${pagina(f.ruta)}`)} />
            <td class="sellos">{f.base.map((b) => <span class="chip" data-sello={b} set:html={o(`fig.F35.base.${b}`)} />)}</td>
            <td class="huella">{f.base.map((b) => corta(b) ? <code>{corta(b)}</code> : <Fragment set:html={marcaPendiente('sello.json')} />)}</td>
            <td class="arch">{f.archivos.length ? f.archivos.map((a) => <a href={recurso(rutaDatos(a, 'csv'))} download>{a}.csv</a>) : <span class="sin" set:html={o('fig.F35.sin_datos')} />}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

<style>
  .bases { scroll-margin-top: 2rem; }
  .huellas { margin: 0 0 var(--e6); display: grid; gap: .55rem; max-width: 52rem; }
  #bases-huellas { margin-bottom: .6rem; }
  .huellas > div { display: grid; grid-template-columns: minmax(0, 1fr); gap: .15rem 1rem; padding-bottom: .5rem; border-bottom: 1px solid var(--hair); }
  .huellas dt { display: flex; flex-wrap: wrap; align-items: center; gap: .3rem .6rem; }
  .huellas dd { margin: 0; min-width: 0; }
  .huellas code { font-size: var(--fs-mono-s); color: var(--ink-2); overflow-wrap: anywhere; word-break: break-all; }
  .huellas time { font: 400 var(--fs-mono-s)/1.4 var(--mono); color: var(--ink-2); }
  .que { font-size: var(--fs-small); color: var(--ink-2); }
  @media (min-width: 56rem) { .huellas > div { grid-template-columns: minmax(0, 22rem) minmax(0, 1fr); align-items: baseline; } }
  .tabla-bases th[scope='row'] { font-family: var(--text); font-size: var(--fs-small); min-width: 15rem; white-space: normal; }
  .fid { font: 400 var(--fs-mono-s)/1 var(--mono); color: var(--mute); margin-right: .3rem; }
  .pag { font-family: var(--text); font-size: var(--fs-small); color: var(--ink-2); white-space: nowrap; }
  .chip { display: block; width: max-content; margin: 0 0 .3rem; font: 400 var(--fs-mono-s)/1.4 var(--mono); color: var(--ink-2); border: 1px solid var(--hair-2); border-radius: var(--radio); padding: .05em .45em; }
  .chip[data-sello='v3'] { border-style: dashed; }
  .chip[data-sello='afin'] { border-color: var(--accent); }
  .huella code, .arch a { display: block; margin: 0 0 .3rem; width: max-content; }
  .huella code { line-height: 1.4; padding-block: .05em; }
  .tabla-bases th :global(data.cifra) { font-family: inherit; }
  .huella code { color: var(--ink-2); font-size: .78rem; }
  .sin { font-family: var(--text); color: var(--mute); font-size: var(--fs-small); }
</style>
