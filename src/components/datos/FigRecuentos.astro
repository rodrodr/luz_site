---
/**
 * F33 · Cinco maneras de contar «palabra» (Usar los datos, #palabra). Plan § F33 y anexo V28 (`FigRecuentos`).
 * Cinco barras horizontales desde cero, una por recuento, con su rótulo, su valor y su diferencia con `nwords` (la
 * columna del CSV), que queda marcada como línea de referencia. Las dos de la V2 van en oro lleno; las tres de la v3,
 * con el contorno discontinuo de lo que no está depositado (otro trazo, no solo otro color), como su sello.
 * Nota emergente: rótulo · valor · definición y, en las de la V2, la línea de código que la reproduce.
 * Datos: `src/data/palabras.json`. Copy: `fig.F33.<k>.rotulo|valor|def|codigo`, `fig.F33.*`.
 */
import FiguraMarco from '../FiguraMarco.astro';
import { t, plano, plantillaNota, existe } from '../../lib/i18n';
import { fmt, marcaPendiente } from '../../lib/cifras';
import { dato } from '../../lib/datos';
import { lineal, marcasAjustadas, pct } from '../../viz/geom/escalas';
import type { Lang } from '../../lib/idiomas';

interface Recuento { k: string; base: 'V2' | 'v3'; clave: string; valor: number; codigo: string | null }
interface Props { lang: Lang; sufijo?: string }
const { lang, sufijo = '' } = Astro.props;
const D = dato<{ recuentos: Recuento[]; maximo: number }>('palabras');
const R = D?.recuentos ?? [];
const o = (k: string, ctx = {}) => (existe(k) ? t(lang, k, ctx) : marcaPendiente(k, 'copy'));
const ancla = `palabra${sufijo}`;
const ref = R.find((r) => r.k === 'nwords')?.valor ?? 0;
const { tope, valores } = marcasAjustadas(D?.maximo ?? 1, 5);
const x = lineal([0, tope]);
const signo = (v: number) => (v > 0 ? '+' : v < 0 ? '−' : '±');
const dif = (r: Recuento) => {
  const d = r.valor - ref;
  return `${signo(d)}${fmt.dato(Math.abs(d), fmt.n(Math.abs(d), lang), `fig.F33.${r.k}.diferencia`, r.base)}`;
};
const plantillaD = plantillaNota(lang, 'fig.F33.nota', ['rotulo', 'valor', 'def']);
---
<FiguraMarco lang={lang} id="F33" sufijo={sufijo} plantilla={plantillaD} plantillaB="{codigo}">
  <div slot="grafico" class="recuentos">
    <ul class="leyenda" role="list">
      <li><span class="muestra v2" aria-hidden="true"></span><span set:html={t(lang, 'comun.sello.V2')} /></li>
      <li><span class="muestra v3" aria-hidden="true"></span><span set:html={t(lang, 'comun.sello.v3')} /></li>
      <li><span class="muestra ref" aria-hidden="true"></span><code>nwords</code></li>
    </ul>
    <div class="plano" style={`--ref: ${pct(x(ref))}`}>
      <div class="rejilla" aria-hidden="true">
        {valores.map((v) => <span style={`--x: ${pct(x(v))}`} />)}
      </div>
      <ol class="filas" role="list" data-recorre tabindex="0" aria-label={plano(lang, 'fig.F33.pregunta')} aria-describedby={`${ancla}-teclado`}>
        {R.map((r) => (
          <li class:list={['fila', r.base === 'v3' ? 'es-v3' : 'es-v2']} data-paso data-nota
            data-v-rotulo={plano(lang, `fig.F33.${r.k}.rotulo`)} data-v-valor={fmt.n(r.valor, lang)} data-v-def={plano(lang, `fig.F33.${r.k}.def`)}
            data-v-codigo={r.codigo ?? undefined}>
            <span class="rotulo" set:html={o(`fig.F33.${r.k}.rotulo`)} />
            <span class="carril"><span class="barra" style={`--p: ${pct(x(r.valor))}`} /></span>
            <span class="valor"><Fragment set:html={o(`fig.F33.${r.k}.valor`)} />{r.k !== 'nwords' && <span class="dif" set:html={dif(r)} />}</span>
          </li>
        ))}
      </ol>
      <div class="eje" aria-hidden="true" data-audit-exento="eje de la figura">
        {valores.map((v) => <span style={`--x: ${pct(x(v))}`}>{fmt.n(v / 1e6, lang)}</span>)}
      </div>
    </div>
    <p class="unidad" aria-hidden="true" set:html={o('fig.F33.eje')} />
  </div>
  <div slot="tabla">
    <div class="fig-desliza" tabindex="0" role="region" aria-labelledby={`${ancla}-caption`}>
      <table class="fig-tabla">
        <caption id={`${ancla}-caption`}><span class="fig-rotulo-tabla" set:html={o('fig.F33.titulo')} /></caption>
        <thead>
          <tr>
            <th scope="col" set:html={o('fig.F33.tabla.col.recuento')} />
            <th scope="col" class="num" set:html={o('fig.F33.tabla.col.valor')} />
            <th scope="col" class="num" set:html={o('fig.F33.tabla.col.diferencia')} />
            <th scope="col" set:html={o('fig.F33.tabla.col.edicion')} />
            <th scope="col" set:html={o('fig.F33.tabla.col.def')} />
          </tr>
        </thead>
        <tbody>
          {R.map((r) => (
            <tr>
              <th scope="row" set:html={o(`fig.F33.${r.k}.rotulo`)} />
              <td class="num" set:html={o(`fig.F33.${r.k}.valor`)} />
              <td class="num" set:html={r.k === 'nwords' ? '—' : dif(r)} />
              <td>{r.base}</td>
              <td class="def-celda">
                <span set:html={o(`fig.F33.${r.k}.def`)} />
                {r.codigo && <><br /><code>{r.codigo}</code></>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</FiguraMarco>

<style>
  .leyenda { list-style: none; margin: 0 0 var(--e5); padding: 0; display: flex; flex-wrap: wrap; gap: .5rem 1.6rem; font-size: var(--fs-small); color: var(--ink-2); }
  .leyenda code { font-size: .86em; }
  .leyenda li { display: inline-flex; align-items: center; gap: .5rem; }
  .muestra { width: 1.6rem; height: .8rem; border-radius: 1px; flex: none; }
  .muestra.v2 { background: var(--dato-2); }
  .muestra.v3 { border: 1.5px dashed var(--dato-2); background: color-mix(in oklab, var(--dato-2) 18%, transparent); }
  .muestra.ref { width: 0; height: 1rem; border-left: 1.5px dashed var(--ink-2); border-radius: 0; margin-inline: .4rem; }
  .plano { position: relative; --rot: 12.5rem; --val: 10.5rem; }
  .rejilla, .eje { position: absolute; left: 0; right: 0; }
  .rejilla { top: 0; bottom: 1.6rem; pointer-events: none; }
  .rejilla span, .eje span { position: absolute; left: var(--x); }
  .rejilla span { top: 0; bottom: 0; border-left: 1px solid var(--hair); }
  .rejilla span:first-child { border-left-color: var(--hair-2); }
  .eje { bottom: 0; height: 1.6rem; font: 400 var(--fs-mono-s)/1 var(--mono); color: var(--mute); }
  .eje span { transform: translateX(-50%); top: .55rem; white-space: nowrap; }
  .eje span:first-child { transform: none; }
  .unidad { font: 400 var(--fs-mono-s)/1.3 var(--mono); color: var(--mute); text-align: right; margin: .25rem 0 0; max-width: none; }
  /* La rejilla, la referencia y el eje viven en el carril (la columna central) desde 48 rem. */
  .filas { list-style: none; margin: 0; padding: 0 0 1.6rem; display: grid; gap: 1.1rem; position: relative; }
  .fila { display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: 'rotulo valor' 'carril carril'; gap: .3rem 1rem; align-items: baseline; }
  .fila:focus { outline: none; }
  /* La marca activa es la barra, no la fila entera (DESIGN.md: contorno de 2 px en tinta, 1 px de separación). */
  .fila:global(.fig-activa) { outline: none; }
  .fila:global(.fig-activa) .barra { outline: 2px solid var(--ink); outline-offset: 1px; }
  .rotulo { grid-area: rotulo; font-size: var(--fs-small); color: var(--ink); }
  .rotulo :global(code) { font-size: .86em; }
  .valor { grid-area: valor; font: 500 .82rem/1.3 var(--mono); color: var(--ink); text-align: right; white-space: nowrap; }
  .dif { display: block; font-weight: 400; font-size: var(--fs-mono-s); color: var(--mute); }
  .carril { grid-area: carril; position: relative; height: 1.15rem; }
  .barra { position: absolute; left: 0; top: 0; bottom: 0; width: var(--p); border-radius: 1px; background: var(--dato-2); }
  .es-v3 .barra { background: color-mix(in oklab, var(--dato-2) 18%, transparent); border: 1.5px dashed var(--dato-2); }
  .carril::after { content: ''; position: absolute; left: var(--ref); top: -.35rem; bottom: -.35rem; border-left: 1.5px dashed var(--ink-2); }
  /* En el móvil la rejilla ocupa el carril entero: el carril va a todo el ancho. */
  @media (min-width: 48rem) {
    .fila { grid-template-columns: var(--rot) minmax(0, 1fr) var(--val); grid-template-areas: 'rotulo carril valor'; align-items: center; }
    .rejilla, .eje { left: calc(var(--rot) + 1rem); right: calc(var(--val) + 1rem); }
  }
  @media (max-width: 47.99rem) {
    .rejilla, .eje { display: none; }
    .unidad { display: none; }
  }
  .def-celda { font-family: var(--text); font-size: var(--fs-small); min-width: 18rem; white-space: normal; }
</style>
