---
/**
 * F32 · Las columnas del CSV depositado (Usar los datos, #columnas). Plan § F32; DESIGN.md «el Diario, anotado al
 * margen»: cada columna es una línea del registro —su nombre en mono, su tipo y sus vacíos—, su definición con el valor
 * real en dos filas seguidas (la Presidencia pide silencio; Campoamor empieza a hablar) y, al margen, cuántos valores
 * distintos tiene. Solo describe las variables (24-09-2026: sin «trampas»). Sin tira de llenado.
 *  · Gráfico: la lista anotada. Cada columna lleva ancla `#col-<columna>` (`:target` la resalta) y su nombre es la marca
 *    recorrible con el teclado (nota: «columna · vacíos de filas»).
 *  · Tabla: las columnas con tipo, vacíos, valores distintos y los dos valores, en su caja deslizable.
 * Datos: `src/data/columnas.json` (exportador/modulos/datos.py). Copy: `datos.columnas.<columna>.*` y `fig.F32.*`.
 */
import FiguraMarco from '../FiguraMarco.astro';
import { t, plano, plantillaNota, existe } from '../../lib/i18n';
import { fmt, escapa, marcaPendiente } from '../../lib/cifras';
import { htmlFija } from '../../lib/lectura';
import { dato } from '../../lib/datos';
import type { Lang } from '../../lib/idiomas';

interface Col { columna: string; tipo: 'entero' | 'texto' | 'fecha'; vacios: number; distintos: number; den: number; v5423: string; v5424: string; v5424_caracteres: number | null }
interface Props { lang: Lang; sufijo?: string }
const { lang, sufijo = '' } = Astro.props;
const D = dato<{ columnas: Col[] }>('columnas');
const cols = D?.columnas ?? [];
const o = (k: string, ctx = {}) => (existe(k) ? t(lang, k, ctx) : marcaPendiente(k, 'copy'));
const ancla = `columnas${sufijo}`;
const n = (v: number, clave: string) => fmt.dato(v, fmt.n(v, lang), clave, 'V2');

/** Valor de una celda de ejemplo: el texto del Diario en cursiva y cortado; lo demás, literal en mono; el vacío, dibujado. */
function valor(c: Col, v: string, cortado: number | null = null): string {
  if (v === '') return `<span class="vacio">${o('fig.F32.vacio')}</span>`;
  if (c.columna === 'speech') {
    const corto = v.length > 150 ? `${escapa(v.slice(0, 150).replace(/\s+\S*$/, ''))} […]` : escapa(v);
    const total = cortado ? ` <span class="corte">${o('fig.F32.cortado', { vars: { n: n(cortado, `fig.F32.speech.caracteres`) } })}</span>` : '';
    return `<q class="dicho" data-audit-exento="cita literal del Diario">${corto}</q>${total}`;
  }
  return `<code>${escapa(v)}</code>`;
}
const estado = (c: Col) => c.vacios
  ? o('fig.F32.vacios', { vars: { n: n(c.vacios, `fig.F32.${c.columna}.vacios`) } })
  : o('fig.F32.sin_vacios');
const tras = (columna: string) => (columna === 'legislature' ? htmlFija(lang, 'comun.fija.legislatura') : '');
const plantilla = plantillaNota(lang, 'fig.F32.nota', ['columna', 'vacios', 'den']);
const colSilencio = o('fig.F32.tabla.col.silencio');
const colCampoamor = o('fig.F32.tabla.col.campoamor');
---
<FiguraMarco lang={lang} id="F32" sufijo={sufijo} plantilla={plantilla}>
  <div slot="grafico" class="columnas">
    {cols.length === 0 ? <p set:html={marcaPendiente('columnas.json')} /> : (
      <>
        <p class="cabecera" aria-hidden="true">
          <span set:html={o('fig.F32.tabla.col.columna')} />
          <span set:html={o('fig.F32.tabla.col.definicion')} />
          <span set:html={o('fig.F32.tabla.col.distintos')} />
        </p>
        <ol class="lista" role="list" data-recorre tabindex="0" aria-label={plano(lang, 'fig.F32.titulo')} aria-describedby={`${ancla}-teclado`}>
          {cols.map((c) => (
            <li class="col" id={`col-${c.columna}`}>
              <div class="nombre">
                <a class="marca" href={`#col-${c.columna}`} tabindex="-1" data-nota data-paso
                  data-v-columna={c.columna} data-v-vacios={fmt.n(c.vacios, lang)} data-v-den={fmt.n(c.den, lang)}>
                  <code>{c.columna}</code>
                </a>
                <span class="tipo"><Fragment set:html={o(`fig.F32.tipo.${c.tipo}`)} /> · <Fragment set:html={estado(c)} /></span>
              </div>
              <div class="def">
                <p set:html={o(`datos.columnas.${c.columna}.definicion`)} />
                <dl class="ej">
                  <div><dt set:html={colSilencio} /><dd set:html={valor(c, c.v5423)} /></div>
                  <div><dt set:html={colCampoamor} /><dd set:html={valor(c, c.v5424, c.v5424_caracteres)} /></div>
                </dl>
              </div>
              <aside class="margen">
                <p class="asiento" set:html={o('fig.F32.distintos', { vars: { n: n(c.distintos, `fig.F32.${c.columna}.distintos`) } })} />
                <Fragment set:html={tras(c.columna)} />
              </aside>
            </li>
          ))}
        </ol>
      </>
    )}
  </div>
  <div slot="tabla">
    <div class="fig-desliza" tabindex="0" role="region" aria-labelledby={`${ancla}-caption`}>
      <table class="fig-tabla tabla-cols">
        <caption id={`${ancla}-caption`}><span class="fig-rotulo-tabla" set:html={o('fig.F32.titulo')} /></caption>
        <thead>
          <tr>
            <th scope="col" set:html={o('fig.F32.tabla.col.columna')} />
            <th scope="col" set:html={o('fig.F32.tabla.col.tipo')} />
            <th scope="col" class="num" set:html={o('fig.F32.tabla.col.vacios')} />
            <th scope="col" class="num" set:html={o('fig.F32.tabla.col.distintos')} />
            <th scope="col" set:html={colSilencio} />
            <th scope="col" set:html={colCampoamor} />
          </tr>
        </thead>
        <tbody>
          {cols.map((c) => (
            <tr>
              <th scope="row"><code>{c.columna}</code></th>
              <td set:html={o(`fig.F32.tipo.${c.tipo}`)} />
              <td class="num" set:html={n(c.vacios, `fig.F32.${c.columna}.vacios`)} />
              <td class="num" set:html={n(c.distintos, `fig.F32.${c.columna}.distintos`)} />
              <td class="celda" set:html={valor(c, c.v5423)} />
              <td class="celda" set:html={valor(c, c.v5424)} />
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="nota fig-pie-tabla" set:html={t(lang, 'comun.fig.tabla.nota')} />
  </div>
</FiguraMarco>

<style>
  .columnas { --col-nombre: 11.5rem; --col-margen: minmax(12rem, 16rem); }
  .cabecera { display: none; }
  .lista { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--hair-2); }
  .col {
    display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--e3) var(--col-gap);
    padding: var(--e5) 0 var(--e5); border-bottom: 1px solid var(--hair); scroll-margin-top: 5rem;
  }
  .col:target { background: var(--bg-2); margin-inline: calc(-1 * var(--e3)); padding-inline: var(--e3); }
  .nombre { display: flex; flex-wrap: wrap; align-items: baseline; gap: .15rem .9rem; min-width: 0; }
  @media (min-width: 48rem) { .nombre { flex-direction: column; align-items: flex-start; gap: 0; } .marca { min-height: 0; padding-block: .1rem .25rem; } }
  .marca { text-decoration: none; color: var(--ink); display: inline-flex; align-items: baseline; min-height: 2.75rem; padding-block: .35rem; }
  .marca code { font: 500 1.02rem/1.2 var(--mono); }
  .marca:hover code { color: var(--accent); }
  .marca:global(.fig-activa) { outline: 2px solid var(--ink); outline-offset: 1px; }
  .tipo { font: 400 var(--fs-mono-s)/1.4 var(--mono); color: var(--mute); }
  .def p { margin: 0 0 var(--e3); }
  .ej { margin: 0; display: grid; gap: .35rem; }
  .ej > div { display: grid; grid-template-columns: 8.25rem minmax(0, 1fr); gap: .75rem; align-items: baseline; }
  .ej dt { font: 400 var(--fs-mono-s)/1.5 var(--mono); color: var(--mute); white-space: nowrap; }
  .ej dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }
  .ej code, .celda code { font-size: .82rem; color: var(--ink); }
  .dicho { font-style: italic; color: var(--ink); }
  .corte { font: 400 var(--fs-mono-s)/1.4 var(--mono); color: var(--mute); font-style: normal; white-space: nowrap; }
  /* Una celda vacía es una ausencia medida: contorno continuo `ausencia-trazo`, sin relleno (la ausencia nunca es un color). */
  .vacio { display: inline-block; font: 400 var(--fs-mono-s)/1.3 var(--mono); color: var(--mute); border: 1px solid var(--ausencia-trazo); border-radius: var(--radio); padding: .05rem .4rem; }
  .margen { font-size: var(--fs-small); line-height: 1.5; color: var(--ink-2); min-width: 0; }
  .margen p { margin: 0 0 .5em; max-width: 32rem; }
  .margen .asiento { margin: 0 0 .35rem; font-size: var(--fs-mono-s); }
  .margen :global(.fija) { border-top: 0; padding-top: 0; margin: .5rem 0 0; font-size: .92em; color: var(--mute); }
  .tabla-cols .celda { min-width: 14rem; max-width: 26rem; white-space: normal; font-family: var(--text); }
  .tabla-cols tbody th { position: sticky; left: 0; background: var(--bg); z-index: 1; }
  @media (min-width: 48rem) {
    .col { grid-template-columns: var(--col-nombre) minmax(0, 1fr); }
    .margen { grid-column: 2; }
  }
  @media (min-width: 72rem) {
    .cabecera {
      display: grid; grid-template-columns: var(--col-nombre) minmax(0, 1fr) var(--col-margen); gap: 0 var(--col-gap);
      font: 400 var(--fs-mono-s)/1.3 var(--mono); color: var(--mute); margin: 0 0 .6rem; max-width: none;
    }
    .col { grid-template-columns: var(--col-nombre) minmax(0, 1fr) var(--col-margen); }
    .margen { grid-column: 3; padding-top: .45rem; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .col { transition: background-color var(--t-estado) var(--ease); }
  }
</style>
