---
/**
 * La cita de un conjunto en tres formatos, Texto · BibTeX · RIS, en pestañas SIN JavaScript (radios y `:has()`, como
 * las de las figuras). Cada formato es su propio bloque copiable (`[data-copiable]`, scripts/copiar.ts), así que
 * [Copiar la cita] copia exactamente el formato que se ve. Sin `:has()`, los tres se leen seguidos. La cita no se
 * teclea: sale de la instantánea de Dataverse (`lib/cita.ts`), tal como la da Dataverse.
 * Copy: `datos.citar.pestana.texto|bibtex|ris`, `datos.citar.copiar`, `comun.cita.*`.
 */
import { t, plano, rotulo, existe } from '../../lib/i18n';
import { escapa, marcaPendiente } from '../../lib/cifras';
import type { Lang } from '../../lib/idiomas';

interface Props { lang: Lang; id: string; texto: string; bibtex: string | null; ris: string | null; nota?: string }
const { lang, id, texto, bibtex, ris, nota } = Astro.props;
const o = (k: string) => (existe(k) ? t(lang, k) : marcaPendiente(k, 'copy'));
const yaEsHtml = /<(mark|data|span|strong|em|code|time|a)\b|&(amp|lt|gt|quot);/.test(texto);
const P = [
  { k: 'texto', cuerpo: yaEsHtml ? texto : escapa(texto), pre: false },
  { k: 'bibtex', cuerpo: bibtex ? escapa(bibtex) : null, pre: true },
  { k: 'ris', cuerpo: ris ? escapa(ris) : null, pre: true },
].filter((p) => p.cuerpo !== null);
const copiar = rotulo(lang, 'datos.citar.copiar');
const copiada = plano(lang, 'comun.cita.copiada');
const noCopiada = plano(lang, 'comun.isla.no_copiado');
---
<div class="cita-pest" data-autoria>
  <div class="barra no-imprimir" role="radiogroup" aria-label={plano(lang, 'comun.cita.formatos.aria')}>
    {P.map((p, i) => (
      <span class="opcion">
        <input class="radio" type="radio" name={`${id}-formato`} id={`${id}-${p.k}`} value={p.k} checked={i === 0} />
        <label for={`${id}-${p.k}`} set:html={o(`datos.citar.pestana.${p.k}`)} />
      </span>
    ))}
  </div>
  {P.map((p) => (
    <div class="panel" data-panel={p.k} data-copiable>
      {p.pre
        ? <pre data-copiar-texto translate="no"><code set:html={p.cuerpo} /></pre>
        : <p class="cita-texto" data-copiar-texto translate="no" lang="en" set:html={p.cuerpo} />}
      <p class="cita-acciones no-imprimir">
        <button type="button" class="boton sec" data-copiar hidden><svg class="icono" aria-hidden="true" focusable="false"><use href="#i-copiar"></use></svg><span set:html={copiar} /></button>
        <span class="cita-aviso" role="status" data-copiar-aviso data-copiada={copiada} data-no-copiada={noCopiada}></span>
      </p>
    </div>
  ))}
  {nota && <p class="nota cita-nota" set:html={nota} />}
</div>

<script>
  import '../../scripts/copiar.ts';
</script>

<style>
  .cita-pest { border-top: 1px solid var(--hair-2); padding-top: var(--e3); max-width: 46rem; margin: var(--e4) 0 var(--e6); min-width: 0; }
  .barra { display: flex; gap: .15rem; margin: 0 0 var(--e4); border-bottom: 1px solid var(--hair); }
  .opcion { position: relative; display: inline-flex; }
  .radio { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
  .opcion label { display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 .8rem; font: 400 1rem/1 var(--text); color: var(--ink-2); border-bottom: 2px solid transparent; margin-bottom: -1px; cursor: pointer; }
  .opcion:first-child label { padding-left: 0; }
  .opcion:hover label { color: var(--ink); }
  .radio:checked + label { color: var(--ink); border-bottom-color: var(--accent); }
  .radio:focus-visible + label { outline: 3px solid var(--focus); outline-offset: 2px; border-radius: var(--radio); }
  @supports selector(:has(*)) {
    .panel { display: none; }
    .cita-pest:has(.radio[value='texto']:checked) .panel[data-panel='texto'],
    .cita-pest:has(.radio[value='bibtex']:checked) .panel[data-panel='bibtex'],
    .cita-pest:has(.radio[value='ris']:checked) .panel[data-panel='ris'] { display: block; }
  }
  @supports not selector(:has(*)) {
    .barra { display: none; }
    .panel + .panel { margin-top: 1.5rem; padding-top: 1rem; border-top: 1px dashed var(--hair-2); }
  }
  .cita-texto { margin: 0; max-width: none; font: 400 var(--fs-body)/1.5 var(--text); overflow-wrap: anywhere; -webkit-user-select: all; user-select: all; }
  pre { margin: 0; font-size: .78rem; white-space: pre-wrap; overflow-wrap: anywhere; -webkit-user-select: all; user-select: all; }
  .cita-acciones { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem 1rem; margin: .9rem 0 0; max-width: none; }
  .cita-acciones [hidden] { display: none; }
  .cita-aviso { font: 500 .75rem/1.2 var(--mono); color: var(--ink-2); }
  .cita-nota { margin: .6rem 0 0; }
  @media print { .panel { display: block !important; } }
</style>
