---
/**
 * NotaBases (frase fija ↺ 13): va en TODA página que pinte una cifra de la edición del explorador (v3).
 * «Esta cifra sale de la edición del explorador (v3, {{filas.v3}} filas, sin depositar); la depositada es la V2
 * ({{filas.V2}} filas). Por qué hay dos →». La auditoría (`audit-cifras.mjs`) falla si una página con
 * `data-base="v3"` no lleva `[data-notabases]`.
 */
import { enlaceFinal } from '../lib/lectura';
import { existe } from '../lib/i18n';
import { url, PAGINAS } from '../lib/rutas';
import type { Lang } from '../lib/idiomas';

interface Props {
  lang: Lang; compacta?: boolean;
  /** Lo v3 de la sección son los ids de sus citas, no una cifra: la frase lo dice (`comun.fija.notabases.ids`). */
  ids?: boolean;
}
const { lang, compacta = false, ids = false } = Astro.props;
// «Por qué hay dos →» es el enlace a Versiones, con la flecha dibujada (lib/lectura.ts › enlaceFinal).
const clave = ids && existe('comun.fija.notabases.ids') ? 'comun.fija.notabases.ids' : 'comun.fija.notabases';
const html = enlaceFinal(lang, clave, url(lang, PAGINAS.versiones));
---
<p class:list={['nota-bases', { compacta }]} data-notabases set:html={html} />

<style>
  /* Es una nota al margen: su forma la da base.css (.nota-bases). */
  .nota-bases.compacta { font-size: .9rem; }
</style>
