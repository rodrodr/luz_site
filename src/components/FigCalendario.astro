---
/**
 * F01 · Calendario de las 755 sesiones, UNA familia en tres escalas (plan § F01 y § F16; DESIGN.md § Sistema de figuras):
 *  · `compacta` (F01c, Inicio): una celda por mes con el tono de sus palabras (5 clases por cuantiles sin interpolar, con
 *    los cortes impresos); cada bloque de etapa enlaza su ficha; hasta tres anotaciones editoriales al margen.
 *  · `completa` (F01, Las Cortes): dentro de cada mes, una barra por sesión (las dos de un mismo día, medias barras); la
 *    altura, palabras o diputados (una conmutación, con radios y CSS); las sesiones con puerta llevan anillo y enlazan.
 *  · `etapa` (F01e, fichas): el bloque de una etapa a todo el ancho y, bajo cada fila de año, las bandas F16 de
 *    presidente titular y de Gobierno (metadatos del proyecto; lo marcado «verificar» va con trazo discontinuo). Un clic
 *    (o Intro) en un tramo resalta sus sesiones. Uso: `<FigCalendario lang={lang} escala="etapa" etapa="I" />`.
 * Capas: datos del exportador (`sesiones.json`, `meses.json`, `calendario.json`, `etapas.json`) → geometría pura
 * (`viz/geom/calendario.ts`) → este componente (formas en HTML de rejilla, todo el texto en HTML, cifras con `data-k`
 * y `data-base`) → la isla común (`scripts/figuras.ts`: nota emergente por plantilla, teclado, toque) → la isla propia
 * (`scripts/fig-calendario.ts`: ficha breve de una sesión, lista de un mes al tocarlo, resalte de F16).
 * Sin JS: el calendario entero, cada etapa y cada puerta son enlaces, y la Tabla y los Datos se abren con sus radios.
 * El marco es el de `FiguraMarco` (mismas clases), con el título y la pregunta de cada escala (`inicio.f01c.*`,
 * `fig.F01.*`, `fig.F01e.*`): FiguraMarco toma el título de la familia del registro y F01c/F01e no tienen familia propia.
 */
import Pestanas from './Pestanas.astro';
import Sello from './Sello.astro';
import { t, plano, rotulo, existe, plantillaNota } from '../lib/i18n';
import { fmt, escapa, marcaPendiente } from '../lib/cifras';
import { dato } from '../lib/datos';
import { rutaDatos, rutaLeame, rutaImagen } from '../lib/figuras';
import { url, recurso, PAGINAS, ETAPAS } from '../lib/rutas';
import { citaFigura, huella } from '../lib/cita';
import { mesLargo, fechaCorta } from '../lib/formato';
import { LANGS, type Lang } from '../lib/idiomas';
import { filasMeses } from '../viz/tabla-calendario';
import {
  rejilla, filasTabla, cabe,
  type MesDato, type SesionDato, type CalendarioDato, type Celda, type Barra, type Segmento, type Bloque,
} from '../viz/geom/calendario';

type Escala = 'compacta' | 'completa' | 'etapa';
interface Props { lang: Lang; escala?: Escala; etapa?: 'I' | 'II' | 'III' | 'IV' | 'V'; id?: string }
const { lang, escala = 'completa', etapa, id } = Astro.props;
if (escala === 'etapa' && !etapa) throw new Error('FigCalendario escala="etapa" necesita la prop `etapa` (I…V).');

interface EtapaReg { id: string; slug: string; sigla: string; presidentes: { clave: string; corto: string; sesiones: number }[]; gobiernos: { id: string; nombre: string; sesiones: number; primera: string; ultima: string }[] }
interface EtapasDato { etapas: EtapaReg[]; presidentes: { clave: string; nombre: string; corto: string; verificar: boolean }[]; gobiernos: { id: string; nombre: string; verificar: boolean }[] }
const S = dato<{ sesiones: SesionDato[] }>('sesiones');
const M = dato<{ meses: MesDato[] }>('meses');
const CAL = dato<CalendarioDato>('calendario');
const ET = dato<EtapasDato>('etapas');
const listo = !!(S && M && CAL && ET);

const ANCLA = id ?? { compacta: 'f01c', completa: 'calendario', etapa: 'calendario-etapa' }[escala];
const CODIGO = { compacta: 'F01c', completa: 'F01', etapa: 'F01e' }[escala];
const FAM = { compacta: 'inicio.f01c', completa: 'fig.F01', etapa: 'fig.F01e' }[escala];
const tituloId = `${ANCLA}-titulo`;
const o = (k: string, ctx = {}) => (existe(k) ? t(lang, k, ctx) : marcaPendiente(k, 'copy'));
const n = (x: number) => fmt.n(x, lang);
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const conBarras = escala !== 'compacta';
const bandas = escala === 'etapa';

// ── plantillas de la nota emergente (tres líneas: qué · cifras · base). Los huecos del copy llevan nombres largos
//    ({{palabras}}); en los atributos, letras (data-v-p), para que 755 barras no pesen de más.
const CORTOS: Record<string, string> = { mes: 'm', sesiones: 's', filas: 'r', palabras: 'p', diputados: 'u', fecha: 'f', num: 's', diario: 'd', p1: 'a', p2: 'b', nombre: 'n', desde: 'a', hasta: 'b', n: 'k' };
const pl = (clave: string, extra: Record<string, string> = {}) =>
  existe(clave) ? Object.entries(extra).reduce((s, [k, v]) => s.split(`{${k}}`).join(v),
    plantillaNota(lang, clave, [...Object.keys(CORTOS), ...Object.keys(extra)])).replace(/\{(\w+)\}/g, (x, k: string) => (CORTOS[k] ? `{${CORTOS[k]}}` : x)) : `⟦${clave}⟧`;
const PL = {
  mes: pl('fig.F01.nota.mes'), mesUna: pl('fig.F01.nota.mes_una'), mesVacio: pl('fig.F01.nota.mes_vacio'),
  base: pl('fig.F01.nota.base'), baseVacio: pl('fig.F01.nota.base_vacio'),
  ses: pl('fig.F01.nota.sesion'), puerta: existe('fig.F01.nota.puerta') ? plano(lang, 'fig.F01.nota.puerta') : '',
  tramo: pl('fig.F16.nota'), tramoUna: pl('fig.F16.nota_una').replace('{f}', '{a}'),
  tramoB: pl('fig.F16.nota.base'), tramoVer: pl('fig.F16.nota.verificar'),
};
// En los metadatos del proyecto el número del Diario coincide con el de la sesión en las 755 (se comprueba abajo): la
// plantilla usa {s} y solo una barra que no coincidiera traería su `data-v-d` y su propia línea de base.
const sesB = (sigla: string, conPaginas: boolean, propio = false) => pl(conPaginas ? 'fig.F01.nota.sesion.base' : 'fig.F01.nota.sesion_sin_paginas.base', { sigla }).replace(propio ? '\u0000' : '{d}', '{s}');

let R: ReturnType<typeof rejilla> | null = null;
let etReg: Record<string, EtapaReg> = {};
if (listo) {
  R = rejilla(M!.meses, S!.sesiones, CAL!, escala === 'etapa' ? etapa : undefined);
  etReg = Object.fromEntries(ET!.etapas.map((e) => [e.id, e]));
}
const slugDe = (e: string) => ETAPAS.find((x) => x.id === e)!.slug;
const nombreEtapa = (e: string) => (escala === 'compacta' ? o(`comun.etapa.${e}.nombre`) : o(`cortes.etapa.${e}.nombre`));
const puertaTitulo = (slug: string) => (existe(`inicio.puertas.${slug}.que`) ? plano(lang, `inicio.puertas.${slug}.que`) : slug);

// ── anotaciones editoriales (solo F01c): junto a la fila del mes con más palabras, del primer mes vacío o la primera.
function filaAnotada(b: Bloque): number | null {
  if (!existe(`inicio.f01c.anota.${b.id}`)) return null;
  const conMax = b.filas.find((f) => f.celdas.some((c) => c?.mes === CAL!.mes_max.mes));
  if (conMax) return conMax.anio;
  const vacia = b.filas.find((f) => f.celdas.some((c) => c?.estado === 'sin_sesion'));
  return (vacia ?? b.filas[0]).anio;
}

// ── celdas y barras (HTML en cadena: 755 barras con atributos de ámbito pesarían de más; el estilo va con :global) ──
const at = (k: string, v: string | number) => ` data-v-${k}="${escapa(String(v))}"`;
function celdaHtml(c: Celda | null, b: Bloque): string {
  if (!c) return '<span class="c fuera" aria-hidden="true"></span>';
  const d = c.dato;
  const mes = cap(mesLargo(c.mes, lang));
  if (c.estado !== 'sesion') {
    return `<span class="c vacio" data-nota${conBarras ? '' : ' data-paso'} data-n style="--n:${c.n}"${at('m', mes)} data-plantilla="${escapa(PL.mesVacio)}" data-plantilla-b="${escapa(PL.baseVacio)}" data-mes="${c.mes}"></span>`;
  }
  const una = d.sesiones === 1 ? ` data-plantilla="${escapa(PL.mesUna)}"` : '';
  const vals = at('m', mes) + at('s', n(d.sesiones)) + at('r', n(d.filas)) + at('p', n(d.pal)) + at('u', n(d.dip));
  if (!conBarras) return `<span class="c q${c.clase}" data-nota data-paso data-n style="--n:${c.n}"${vals}${una}></span>`;
  const sigla = etReg[b.id]?.sigla ?? '';
  const conPag = c.barras.every((x) => !!x.s.meta.paginas);
  const barras = c.barras.map((x) => barraHtml(x, sigla, conPag)).join('');
  return `<span class="c q${c.clase}" data-nota data-n style="--n:${c.n}"${vals}${una} data-mes="${c.mes}"><span class="bs" data-plantilla="${escapa(PL.ses)}" data-plantilla-t="{f}" data-plantilla-b="${escapa(sesB(sigla, conPag))}">${barras}</span></span>`;
}
// Cada puerta se enlaza UNA vez por figura, desde su primera barra: las demás sesiones de la misma puerta son barras
// sin enlace (con su línea de puerta en la nota). Varios enlaces iguales de 1-8 px, casi pegados, eran objetivos que
// se pisaban (WCAG 2.5.8).
const puertasEnlazadas = new Set<string>();
function barraHtml(x: Barra, sigla: string, conPagCelda: boolean): string {
  const s = x.s;
  const repite = !!x.puerta && puertasEnlazadas.has(x.puerta);
  if (x.puerta) puertasEnlazadas.add(x.puerta);
  const pag = s.meta.paginas;
  let v = at('f', fechaCorta(s.f)) + at('s', s.s) + at('r', n(s.filas)) + at('p', n(s.pal)) + at('u', n(s.dip));
  if (s.meta.num != null && s.meta.num !== s.s) v += at('d', s.meta.num);
  if (pag) v += at('a', pag[0]) + at('b', pag[1]);
  const estilo = ` style="--h:${x.h.toFixed(3).replace(/^0/, '')};--u:${x.u.toFixed(3).replace(/^0/, '')}"`;
  const f16 = bandas ? ` data-pr="${s.meta.pres ?? ''}" data-go="${s.meta.gob ?? ''}"` : '';
  const orden = bandas ? ` data-orden="${x.orden}"` : '';
  // Una barra cuya ranura no casa con la de su mes (páginas verificadas o no) trae su propia línea de base.
  const numPropio = s.meta.num != null && s.meta.num !== s.s;
  const propiaB = !!pag !== conPagCelda || numPropio ? sesB(sigla, !!pag, numPropio) : '';
  if (x.puerta && !repite) {
    const b = `${propiaB || sesB(sigla, !!pag)}${PL.puerta ? ` · ${PL.puerta}` : ''}`;
    const aria = `${fechaCorta(s.f)} · ${puertaTitulo(x.puerta)}`;
    return `<a class="b p${x.doble ? ' d' : ''}" href="${url(lang, `${PAGINAS.sesiones}/${x.puerta}`)}" tabindex="-1" aria-label="${escapa(aria)}" data-nota data-paso${orden}${v}${f16} data-plantilla-b="${escapa(b)}"${estilo}></a>`;
  }
  // la barra que repite puerta conserva su línea de puerta en la nota, sin enlace
  const bRep = repite ? `${propiaB || sesB(sigla, !!pag)}${PL.puerta ? ` · ${PL.puerta}` : ''}` : propiaB;
  return `<i class="b${x.doble ? ' d' : ''}" data-nota data-paso${orden}${v}${f16}${bRep ? ` data-plantilla-b="${escapa(bRep)}"` : ''}${estilo}></i>`;
}
function bandaHtml(segs: Segmento[], banda: 'presidente' | 'gobierno', base: number): string {
  const nombres = Object.fromEntries(ET!.presidentes.map((p) => [p.clave, p.nombre]));
  const piezas = segs.map((g, i) => {
    const tr = g.tramo;
    const rotuloTramo = banda === 'presidente' ? tr.corto : tr.corto;
    const quepo = cabe(g, rotuloTramo);
    const ai = Math.floor(g.a + 1e-9), bi = Math.floor(g.b - 1e-9);
    const nombre = banda === 'presidente' ? (nombres[tr.clave] ?? tr.nombre) : tr.nombre;
    const una = tr.sesiones === 1;
    const clase = ['tr', tr.verificar ? 'ver' : '', g.viene ? 'viene' : '', g.sigue ? 'sigue' : '', quepo.ancho ? 'cabe-a' : '', quepo.medio ? 'cabe-m' : '', quepo.estrecho ? 'cabe-e' : ''].filter(Boolean).join(' ');
    const v = at('n', nombre) + at('a', fechaCorta(tr.desde)) + at('b', fechaCorta(tr.hasta)) + at('k', n(tr.sesiones));
    const pls = (una ? ` data-plantilla="${escapa(PL.tramoUna)}"` : '') + (tr.verificar ? ` data-plantilla-b="${escapa(PL.tramoVer)}"` : '');
    const flecha = g.sigue ? '<svg class="icono" aria-hidden="true" focusable="false"><use href="#i-flecha"></use></svg>' : '';
    return `<span class="${clase}" data-nota data-paso data-orden="${base + i}" data-resalta="${banda === 'presidente' ? 'pr' : 'go'}:${tr.clave}"${v}${pls} style="--a:${g.a.toFixed(4)};--b:${g.b.toFixed(4)};--ai:${ai};--bi:${bi}"><span class="tr-r">${escapa(rotuloTramo)}</span>${flecha}</span>`;
  }).join('');
  return `<div class="banda" data-banda="${banda}" data-plantilla="${escapa(PL.tramo)}" data-plantilla-t="{n}" data-plantilla-b="${escapa(PL.tramoB)}"><span class="banda-rot" aria-hidden="true">${escapa(plano(lang, `fig.F16.banda.${banda}`))}</span><div class="pista">${piezas}</div></div>`;
}

let bloquesHtml = '';
let saltoHtml = '';
let resalteCss = '';
if (R) {
  let ordenTramo = 100000;
  const cuerpo = R.bloques.map((b) => {
    const tot = t(lang, 'fig.F01.cabecera', { vars: { n: fmt.clave(`etapa.${b.id}.sesiones`, lang), palabras: fmt.clave(`etapa.${b.id}.palabras`, lang) } });
    const ficha = url(lang, `${PAGINAS.cortes}/${slugDe(b.id)}`);
    const tip = existe('inicio.f01c.nota.etapa') && escala === 'compacta'
      ? ` data-tip="${escapa(plano(lang, 'inicio.f01c.nota.etapa', { vars: { etapa: plano(lang, `comun.etapa.${b.id}.nombre`), n: n(b.sesiones) } }))}"` : '';
    const nombre = escala === 'etapa'
      ? `<span class="cal-nombre"><span class="cal-rom">${b.id}</span> ${nombreEtapa(b.id)}</span>`
      : `<a class="cal-nombre" href="${ficha}"${tip}><span class="cal-rom">${b.id}</span> ${nombreEtapa(b.id)}</a>`;
    const dice = escala === 'completa' && existe(`cortes.calendario.dice.${b.id}`) ? `<p class="cal-dice">${t(lang, `cortes.calendario.dice.${b.id}`)}${(b.id === 'IV' || b.id === 'V') && existe('fig.F01.salvedad.extractos') ? ` <span class="cal-extracto">${t(lang, 'fig.F01.salvedad.extractos')}</span>` : ''}</p>` : '';
    const anotada = escala === 'compacta' ? filaAnotada(b) : null;
    const filas = b.filas.map((f) => {
      const nota = anotada === f.anio ? `<p class="cal-nota">${t(lang, `inicio.f01c.anota.${b.id}`)}</p>` : '';
      const fila = `<div class="cal-fila"><time class="cal-anio" datetime="${f.anio}">${f.anio}</time>${f.celdas.map((c) => celdaHtml(c, b)).join('')}${nota}</div>`;
      if (!bandas) return fila;
      const bp = bandaHtml(f.presidente, 'presidente', ordenTramo); ordenTramo += f.presidente.length;
      const bg = bandaHtml(f.gobierno, 'gobierno', ordenTramo + 50000); ordenTramo += f.gobierno.length;
      return `<div class="cal-anio-grupo">${fila}${bp}${bg}</div>`;
    }).join('');
    const aria = plano(lang, 'fig.F01.cabecera', { vars: { n: n(b.sesiones), palabras: n(b.palabras) } });
    return `<div class="cal-etapa" data-etapa="${b.id}" data-recorre tabindex="0" role="group" aria-label="${escapa(`${b.id} · ${plano(lang, `comun.etapa.${b.id}.nombre`)} · ${aria}`)}"><div class="cal-cab">${nombre}<span class="cal-tot">${tot}</span>${dice}</div>${filas}</div>`;
  });
  if (R.salto && escala !== 'etapa') {
    const texto = escala === 'completa' && existe('cortes.calendario.dice.hueco')
      ? t(lang, 'cortes.calendario.dice.hueco')
      : t(lang, 'fig.F01.salto', { vars: { desde: fmt.clave('meses.salto.desde', lang, 'mes'), hasta: fmt.clave('meses.salto.hasta', lang, 'mes'), n: fmt.clave('meses.salto', lang) } });
    saltoHtml = `<div class="cal-salto"><span class="cal-anio" aria-hidden="true">//</span><p>${texto}</p></div>`;
  }
  // El salto va entre la guerra (IV) y México (V).
  const iV = R.bloques.findIndex((b) => b.id === 'V');
  bloquesHtml = iV > 0 ? [...cuerpo.slice(0, iV), saltoHtml, ...cuerpo.slice(iV)].join('') : cuerpo.join('');
  if (bandas) {
    const sel = `#${ANCLA}`;
    const claves = new Set<string>();
    R.bloques.forEach((b) => b.filas.forEach((f) => { f.presidente.forEach((g) => claves.add(`pr:${g.tramo.clave}`)); f.gobierno.forEach((g) => claves.add(`go:${g.tramo.clave}`)); }));
    resalteCss = [...claves].map((k) => {
      const [tipo, c] = k.split(':');
      return `${sel}[data-resaltado="${k}"] .b:not([data-${tipo}="${c}"]){opacity:var(--atenua)}${sel}[data-resaltado="${k}"] .tr:not([data-resalta="${k}"]){opacity:.55}${sel}[data-resaltado="${k}"] .tr[data-resalta="${k}"]{outline:2px solid var(--accent);outline-offset:1px}`;
    }).join('');
  }
}

// ── leyenda ──
const clases = CAL?.clases ?? [];
const rango = (i: number) => `${fmt.dato(clases[i].desde, n(clases[i].desde), `f01.clase.${i}.desde`, 'V2')}–${fmt.dato(clases[i].hasta, n(clases[i].hasta), `f01.clase.${i}.hasta`, 'V2')}`;

// ── tabla ──
const tabla = listo ? filasTabla(M!.meses, escala === 'etapa' ? etapa : undefined) : [];
const regE = escala === 'etapa' && listo ? etReg[etapa!] : null;
const presNombre = Object.fromEntries((ET?.presidentes ?? []).map((p) => [p.clave, p]));
const gobNombre = Object.fromEntries((ET?.gobiernos ?? []).map((g) => [g.id, g]));
const tramosE = (banda: 'presidente' | 'gobierno') => (CAL?.tramos[banda] ?? []).filter((x) => x.etapa === etapa);

// Las filas de la tabla, en cadena (sin los atributos de ámbito en cada celda): viz/tabla-calendario.ts.
const filasMesesHtml = filasMeses(lang, tabla, escala !== 'etapa');

// ── datos ──
const archivosF01 = ['sesiones', 'meses'];
const archivos = [
  ...archivosF01.flatMap((a) => [rutaDatos(a, 'csv'), rutaDatos(a, 'xlsx')]),
  ...(bandas ? [rutaDatos('presidencia_gobierno', 'csv'), rutaDatos('presidencia_gobierno', 'xlsx')] : []),
  ...LANGS.map((l) => rutaLeame('F01', l)),
  ...(bandas ? LANGS.map((l) => rutaLeame('F16', l)) : []),
];
const posicion = plano(lang, 'comun.isla.posicion', { vars: { i: '{i}', total: '{total}' } });
const cerrar = existe('comun.isla.cerrar') ? plano(lang, 'comun.isla.cerrar') : undefined;
const bases = bandas ? (['V2', 'proyecto'] as const) : (['V2', 'proyecto'] as const);
const salvedadF01 = existe('fig.F01.salvedad') ? plano(lang, 'fig.F01.salvedad') : '';
const [salv1, ...salvResto] = salvedadF01.split(/(?<=\.)\s+/);
const sub: Record<string, string> = etapa ? { etapa: slugDe(etapa) } : {};
const breve = {
  titulo: pl('fig.F01.breve.titulo'), mes: pl('fig.F01.breve.mes'),
  como: existe('fig.F01.breve.como') ? t(lang, 'fig.F01.breve.como') : '', cerrar: existe('fig.F01.breve.cerrar') ? plano(lang, 'fig.F01.breve.cerrar') : '',
  puerta: existe('fig.F01.nota.puerta') ? plano(lang, 'fig.F01.nota.puerta') : '',
};
---
{listo ? (
  <figure class:list={['figura', 'fig-cal', `fig-cal--${escala}`]} id={ANCLA} data-figura="F01" data-escala={escala} data-base="V2 proyecto"
    data-plantilla={PL.mes} data-plantilla-t="{m}" data-plantilla-b={PL.base} data-posicion={posicion} data-cerrar={cerrar} aria-labelledby={tituloId}>
    <Pestanas lang={lang} id={ANCLA} etiquetadoPor={tituloId}>
      <header class="fig-cabeza" slot="cabeza">
        <p class="fig-sellos"><Sello lang={lang} base="V2" /><Sello lang={lang} base="proyecto" /></p>
        <h3 class="fig-titulo" id={tituloId}><span class="fig-id" aria-hidden="true" data-audit-exento="código de figura">{CODIGO}</span><Fragment set:html={o(`${FAM}.titulo`)} /></h3>
      </header>
      {existe(`${FAM}.pregunta`) && <p class="fig-pregunta" slot="pregunta" set:html={t(lang, `${FAM}.pregunta`)} />}
      {conBarras && (
        <fieldset class="fig-conmuta" slot="barra">
          <legend set:html={t(lang, 'fig.F01.conmuta.titulo')} />
          <label><input type="radio" name={`${ANCLA}-altura`} value="palabras" checked /><span set:html={t(lang, 'fig.F01.conmuta.palabras')} /></label>
          <label><input type="radio" name={`${ANCLA}-altura`} value="diputados" /><span set:html={t(lang, 'fig.F01.conmuta.diputados')} /></label>
        </fieldset>
      )}

      <div slot="grafico" class="fig-lienzo">
        <p class="sr-only" set:html={o(`${FAM}.alt`)} />
        <div class="cal-ley">
          <div class="cal-ley-tono">
            <p class="cal-ley-t" set:html={o('fig.F01.leyenda.tono')} />
            <ol role="list">
