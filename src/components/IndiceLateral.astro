---
/**
 * Índice de una lectura larga (fichas, El Diario, Método, Datos, Versiones, Explorador, Afinidades). DESIGN.md § Índice.
 * En escritorio, pegajoso desde 64 rem al lado del texto (columnas 1–3); en el móvil, un `<details>` nativo: todo sin JS.
 *  · Los rótulos llegan ya resueltos desde el copy: aquí no se escribe ningún texto.
 *  · La numeración la pone un contador de CSS (`decimal-leading-zero`), no el HTML: ningún número se teclea.
 *  · «Dónde estoy»: sin JS, con `view-timeline` por apartado donde el navegador lo admite (contrato con la página: cada
 *    apartado declara `view-timeline-name: --<id>` —lo hace `Seccion` con `indice`— y `.con-indice` declara
 *    `timeline-scope`). Con JS, además, `aria-current="location"` en el apartado que se lee (filete oro de 1 px).
 *  · Subapartados (H3): `sub` en cada entrada; van sin número, más pequeños y sangrados bajo su apartado.
 */
import type { Lang } from '../lib/idiomas';

interface Entrada { id: string; rotulo: string; sub?: { id: string; rotulo: string }[] }
interface Props { lang: Lang; titulo: string; entradas: Entrada[] }
const { titulo, entradas } = Astro.props;
const tituloPlano = titulo.replace(/<[^>]+>/g, '').replace(/[⟦⟧]/g, '').trim();
---
<nav class="indice no-imprimir" aria-label={tituloPlano} data-indice>
  <details class="plegado">
    <summary set:html={titulo} />
    <ol role="list" id="indice-lista">
      {entradas.map((e) => (
        <li>
          <a href={`#${e.id}`}><span set:html={e.rotulo} /></a>
          {e.sub?.length ? <ol role="list" class="sub">{e.sub.map((s) => <li><a href={`#${s.id}`} set:html={s.rotulo} /></li>)}</ol> : null}
        </li>
      ))}
    </ol>
  </details>
  <div class="fijo">
    <ol role="list">
      {entradas.map((e) => (
        <li>
          <a href={`#${e.id}`} style={`animation-timeline: --${e.id}`}><span set:html={e.rotulo} /></a>
          {e.sub?.length ? <ol role="list" class="sub">{e.sub.map((s) => <li><a href={`#${s.id}`} set:html={s.rotulo} /></li>)}</ol> : null}
        </li>
      ))}
    </ol>
  </div>
</nav>

<script>
  // «Volver al índice» (VolverIndice.astro): abre el índice plegado antes de saltar a él, en todos los navegadores.
  document.addEventListener('click', (e) => {
    if (!(e.target as Element | null)?.closest?.('a[href="#indice-lista"]')) return;
    document.querySelector<HTMLDetailsElement>('[data-indice] .plegado')?.setAttribute('open', '');
  });
  // «Dónde estoy» también para el lector de pantalla: aria-current="location" en el apartado que ocupa la ventana.
  document.querySelectorAll<HTMLElement>('[data-indice] .fijo').forEach((fijo) => {
    const enlaces = [...fijo.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const secciones = enlaces.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1)))).filter((x): x is HTMLElement => !!x);
    if (!secciones.length || !('IntersectionObserver' in window)) return;
    const visibles = new Set<Element>();
    const marca = () => {
      const actual = secciones.find((s) => visibles.has(s));
      enlaces.forEach((a) => (a.hash.slice(1) === actual?.id ? a.setAttribute('aria-current', 'location') : a.removeAttribute('aria-current')));
    };
    const io = new IntersectionObserver((es) => { es.forEach((e) => (e.isIntersecting ? visibles.add(e.target) : visibles.delete(e.target))); marca(); }, { rootMargin: '-35% 0px -55% 0px' });
    secciones.forEach((s) => io.observe(s));
  });
</script>

<style>
  .indice { font-size: .95rem; line-height: 1.35; }
  ol { list-style: none; margin: 0; padding: 0; counter-reset: ind; display: grid; gap: .1rem; border-left: 1px solid var(--hair); }
  li { counter-increment: ind; }
  .indice a {
    display: grid; grid-template-columns: 1.9rem 1fr; align-items: baseline; padding: .42rem 0 .42rem .9rem; margin-left: -1px;
    min-height: 2.75rem; color: var(--ink-2); text-decoration: none; border-left: 1px solid transparent;
  }
  .indice a::before { content: counter(ind, decimal-leading-zero); font: 400 var(--fs-mono-s)/1.9 var(--mono); color: var(--mute); }
  .indice a:hover { color: var(--ink); }
  .indice a[aria-current] { color: var(--ink); border-left-color: var(--accent); }
  /* Subapartados: sin número, sangrados bajo su apartado. */
  ol.sub { border-left: 0; counter-reset: none; margin: 0 0 .3rem 2.8rem; gap: 0; }
  ol.sub li { counter-increment: none; }
  .indice ol.sub a { grid-template-columns: 1fr; padding: .3rem 0 .3rem .6rem; font-size: .9rem; min-height: 2.75rem; align-items: center; }
  .indice ol.sub a::before { content: none; }

  .fijo { display: none; }
  .plegado { border-block: 1px solid var(--hair); }
  summary { cursor: pointer; padding: .7rem 0; list-style: none; display: flex; justify-content: space-between; align-items: center; min-height: 2.75rem; font-weight: 600; color: var(--ink); }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; font: 400 1.3rem/1 var(--mono); color: var(--ink-2); }
  .plegado[open] summary::after { content: '–'; }
  .plegado ol { margin-bottom: 1rem; }

  @media (min-width: 64rem) {
    .plegado { display: none; }
    .fijo { display: block; }
    /* El alto descuenta la banda fija de abajo: el último rótulo nunca queda debajo de ella. */
    /* Arranca a la altura del primer H2 (base.css: el primer apartado de una lectura con índice sube a e7). */
    .indice { position: sticky; top: var(--e6); align-self: start; max-height: calc(100vh - 9rem); max-height: calc(100dvh - 9rem); overflow-y: auto; margin-top: var(--e7); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .indice a { transition: color var(--t-puntero) var(--ease), border-color var(--t-puntero) var(--ease); }
    @supports (animation-timeline: view()) and (timeline-scope: --x) {
      .fijo a { animation: indice-aqui linear; }
      @keyframes indice-aqui { from, to { color: var(--ink); border-left-color: var(--accent); } }
    }
  }
</style>
