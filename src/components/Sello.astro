---
/**
 * Sello de base (frase fija ↺ 2): «Edición depositada (V2)» · «Edición del explorador (v3, sin depositar)» ·
 * «Metadatos del proyecto (no depositados; el explorador no los muestra)» · «Afinidades Elegidas (CGOCUS V1.1,
 * depositada)». Una sola redacción por base, en `comun.sello.<base>`.
 */
import { t } from '../lib/i18n';
import type { Lang } from '../lib/idiomas';
import type { Base } from '../lib/cifras';

interface Props { lang: Lang; base: Base; class?: string }
const { lang, base, class: clase } = Astro.props;
---
<span class:list={['sello', clase]} data-sello={base} data-base={base} set:html={t(lang, `comun.sello.${base}`)} />

<style>
  /* Un asiento con su base: mono en caja normal, sin oro; el filete dice qué edición es (discontinuo: sin depositar). */
  .sello { display: inline-block; font: 400 var(--fs-mono-s)/1.4 var(--mono); color: var(--ink-2); border: 1px solid var(--hair-2); border-radius: var(--radio); padding: .2em .55em; }
  .sello[data-sello='v3'] { border-style: dashed; }
  .sello[data-sello='afin'] { border-color: var(--accent); }
</style>
