---
/**
 * J · El explorador (plan § Plantilla J; narrativa § 15; brief `.impeccable/surfaces/src-pages-lang-explorador-astro.md`).
 * Qué hace la herramienta, enseñada DE VERDAD (doce capturas reales y consultas que funcionan) y, al lado, su límite.
 * Nueve apartados con índice lateral y banda fija.
 *  · Primera vista: H1, entrada, garantía y [Abrir el explorador ↗]; debajo, la captura principal (la
 *    búsqueda del voto femenino) en columnas 1–8 con su pie al margen.
 *  · Figuras: F29 (búsquedas de muestra, lista copiable) y F17 (las bibliotecas del proyecto, en el tiempo).
 *  · D-17: de Menciones, solo la matriz, con sus límites en recuadro.
 *  · Lo que NO hace va literal, al final, en su recuadro de trazo discontinuo (lo que la herramienta no trae).
 * Copy: `explorador.*` y `fig.F17.*`, `fig.F29.*` (docs/copy_es/explorador.md). Capturas: `src/assets/explorador/`.
 */
import Base from '../../layouts/Base.astro';
import CabezaPagina from '../../components/CabezaPagina.astro';
import IndiceLateral from '../../components/IndiceLateral.astro';
import Seccion from '../../components/Seccion.astro';
import Captura from '../../components/Captura.astro';
import BandaCTA from '../../components/BandaCTA.astro';
import SinSitio from '../../components/SinSitio.astro';
import Pico from '../../components/explorador/Pico.astro';
import FigBusquedas from '../../components/FigBusquedas.astro';
import FigBibliotecas from '../../components/FigBibliotecas.astro';
import { meta } from '../../lib/pagina';
import { t, tBloques, existe } from '../../lib/i18n';
import { fmt } from '../../lib/cifras';
import { primera, anclasTras, htmlFija, rotulosConDestino, conDestinos } from '../../lib/lectura';
import { remata } from '../../lib/remata';
import { PAGINAS, url } from '../../lib/rutas';
import { rutasPorIdioma, type Lang } from '../../lib/idiomas';
import busqueda from '../../assets/explorador/busqueda.png';
import tendencia from '../../assets/explorador/tendencia.png';
import lector from '../../assets/explorador/lector.png';
import acotaciones from '../../assets/explorador/acotaciones.png';
import corrida from '../../assets/explorador/corrida.png';
import careo from '../../assets/explorador/careo.png';
import bibliotecas from '../../assets/explorador/bibliotecas.png';
import lexico from '../../assets/explorador/lexico.png';
import coocurrencias from '../../assets/explorador/coocurrencias.png';
import menciones from '../../assets/explorador/menciones.png';
import exportar from '../../assets/explorador/exportar.png';

export const getStaticPaths = rutasPorIdioma;
const lang = Astro.params.lang as Lang;
const { titulo, descripcion } = meta(lang, 'explorador');
const X = (k: string) => `explorador.${k}`;
/** Las frases fijas y rótulos que el copy repitió (↺) justo detrás de una clave. */
const tras = (k: string) => anclasTras(k).map((f) => htmlFija(lang, f)).join('');
/** Un texto del copy en bloques (párrafos, listas, negritas), con sus rótulos enlazados y sus ↺ detrás. */
const B = (k: string) => (existe(k) ? rotulosConDestino(lang, remata(tBloques(lang, k)), k) + tras(k) : '');
/** Una línea de botones: cada [rótulo] recibe el destino de su rótulo único (comun.md § 3). */
const botones = (k: string, destinos: string[] = []) => `<p class="botones">${conDestinos(lang, k, {}, destinos)}</p>` + tras(k);
const S = [
  { id: 'encontrar', x: 'encontrar' }, { id: 'muestra', x: 'busquedas' }, { id: 'pico', x: 'pico' }, { id: 'leer', x: 'leer' },
  { id: 'enfocar', x: 'bibliotecas' }, { id: 'coocurrencias', x: 'coocurrencias' }, { id: 'menciones', x: 'menciones' },
  { id: 'llevar', x: 'llevar' }, { id: 'empezar', x: 'empezar' }, { id: 'no-hace', x: 'limites' },
];
const fechaCapturas = fmt.clave('explorador.capturas.fecha', lang, 'fecha_larga');
const PREGUNTAS = ['p1', 'p2', 'p3', 'p4'];
const LIMITES = ['tono', 'focos', 'precision', 'cargos', 'externos'];
const NO_HACE = ['equipo', 'significado', 'operadores', 'mismo_diputado', 'cabecera', 'filtros', 'nombres', 'palabras'];
const PASOS = ['paso1', 'paso2', 'paso3'];
---
<Base lang={lang} ruta={PAGINAS.explorador} titulo={titulo} descripcion={descripcion}>
  <!-- Primera vista: la pregunta a la izquierda; la herramienta, de verdad, a la derecha (captura principal y su pie). -->
  <div class="primera-vista">
    <CabezaPagina lang={lang} prefijo="explorador" extras={lang !== 'es' ? ['idioma'] : []} />
    <div class="heroe">
      <Captura lang={lang} src={busqueda} clave="explorador.img.busqueda" talla="ancha" primera />
      <p class="asiento heroe-fecha" set:html={t(lang, 'comun.captura.pie', { vars: { fecha: fechaCapturas } })} />
    </div>
  </div>

  <div class="contenedor con-indice" style={`timeline-scope: ${S.map((s) => `--${s.id}`).join(', ')}`}>
    <IndiceLateral lang={lang} titulo={t(lang, 'comun.indice.titulo')} entradas={S.map((s) => ({ id: s.id, rotulo: primera(lang, [X(`indice.${s.x}`), X(`${s.x}.titulo`)]) }))} />
    <div class="lectura">

      <!-- 8.2 · Primero, encontrar: cuatro preguntas a dos columnas, sin iconos; Tendencia debajo -->
      <Seccion lang={lang} id="encontrar" prefijo={X('encontrar')} resto={false} indice>
        <div class="ancho preguntas">
          {PREGUNTAS.map((p) => (
            <div class="pregunta">
              <h3 set:html={t(lang, X(`${p}.titulo`))} />
              <Fragment set:html={B(X(`${p}.texto`))} />
              {p === 'p4' && <Fragment set:html={B(X('p4.hitos'))} />}
            </div>
          ))}
        </div>
        <div class="ancho"><Captura lang={lang} src={tendencia} clave="explorador.img.tendencia" /></div>
      </Seccion>

      <!-- 8.2 bis · Búsquedas de muestra (F29): ↺ 5 una vez, tras la entrada (la pinta la sección) -->
      <Seccion lang={lang} id="muestra" prefijo={X('busquedas')} indice>
        <FigBusquedas lang={lang} />
      </Seccion>

      <!-- 8.3 · Leer como en el Diario: la sección central; las cuatro capturas en fila de dos -->
      <Seccion lang={lang} id="pico" prefijo={X('pico')} espera={['titulo', 'entrada']} excluir={['juego']} indice>
        <Pico lang={lang} />
      </Seccion>

      <Seccion lang={lang} id="leer" prefijo={X('leer')} resto={false} indice>
        <Fragment set:html={B(X('leer.lector'))} />
        <Fragment set:html={B(X('leer.acotaciones'))} />
        <Fragment set:html={B(X('leer.corrida'))} />
        <Fragment set:html={B(X('leer.careo'))} />
        <aside class="al-margen" set:html={B(X('leer.careo_limite'))} />
        <Fragment set:html={B(X('leer.mismo'))} />
        <div class="ancho rejilla-capturas">
          <Captura lang={lang} src={lector} clave="explorador.img.lector" />
          <Captura lang={lang} src={acotaciones} clave="explorador.img.acotaciones" />
          <div>
            <Captura lang={lang} src={corrida} clave="explorador.img.corrida" />
            <Fragment set:html={tras('explorador.img.corrida.pie')} />
          </div>
          <Captura lang={lang} src={careo} clave="explorador.img.careo" />
        </div>
      </Seccion>

      <!-- 8.4 · Después, enfocar: las bibliotecas, con F17 -->
      <Seccion lang={lang} id="enfocar" prefijo={X('bibliotecas')} resto={false} indice>
        <Fragment set:html={B(X('bibliotecas.que_es'))} />
        <Fragment set:html={B(X('bibliotecas.guardar'))} />
        <Fragment set:html={B(X('bibliotecas.proyecto'))} />
        <aside class="al-margen" set:html={B(X('bib.entradas'))} />
        <Fragment set:html={B(X('bibliotecas.f17'))} />
        <FigBibliotecas lang={lang} />
        <Fragment set:html={B(X('bibliotecas.enteras'))} />
        <Fragment set:html={B(X('bibliotecas.lexico'))} />
        <div class="ancho par-capturas">
          <Captura lang={lang} src={bibliotecas} clave="explorador.img.bibliotecas" talla="media" />
          <Captura lang={lang} src={lexico} clave="explorador.img.lexico" />
        </div>
      </Seccion>

      <!-- 8.5 · Coocurrencias -->
      <Seccion lang={lang} id="coocurrencias" prefijo={X('coocurrencias')} resto={false} indice>
        <Fragment set:html={B(X('coocurrencias.que_es'))} />
        <Fragment set:html={B(X('coocurrencias.temas'))} />
        <Fragment set:html={B(X('coocurrencias.partidos'))} />
        <div class="ancho"><Captura lang={lang} src={coocurrencias} clave="explorador.img.coocurrencias" /></div>
        <Fragment set:html={B(X('coocurrencias.lector'))} />
        <Fragment set:html={B(X('coocurrencias.metodo'))} />
        <aside class="al-margen" set:html={B(X('coocurrencias.aviso'))} />
      </Seccion>

      <!-- 8.6 · Menciones (D-17 a): solo la matriz, con sus límites en recuadro -->
      <Seccion lang={lang} id="menciones" prefijo={X('menciones')} resto={false} indice>
        <Fragment set:html={B(X('menciones.que_es'))} />
        <Fragment set:html={B(X('menciones.solo_matriz'))} />
        <div class="ancho"><Captura lang={lang} src={menciones} clave="explorador.img.menciones" /></div>
        <div class="recuadro limites-menciones">
          <p class="recuadro-t" set:html={t(lang, X('menciones.limites.titulo'))} />
          <ul>{LIMITES.map((l) => <li set:html={t(lang, X(`menciones.limites.${l}`))} />)}</ul>
        </div>
      </Seccion>

      <!-- 8.7 · Llevárselo, citado -->
      <Seccion lang={lang} id="llevar" prefijo={X('llevar')} resto={false} indice>
        <Fragment set:html={B(X('llevar.formatos'))} />
        <Fragment set:html={B(X('llevar.en_cada'))} />
        <Fragment set:html={B(X('llevar.copiar_pasaje'))} />
        <Fragment set:html={botones(X('llevar.enlace'), [url(lang, `${PAGINAS.datos}#citar`)])} />
        <div class="ancho">
          <Captura lang={lang} src={exportar} clave="explorador.img.exportar" talla="media" />
        </div>
      </Seccion>

      <!-- 8.8 · Cómo empezar: tres pasos (en fila en escritorio), sin tiempos de carga ni «Recordar la base» (C4) -->
      <Seccion lang={lang} id="empezar" prefijo={X('empezar')} resto={false} indice>
        <ol class="ancho pasos" role="list">
          {PASOS.map((p) => <li set:html={tBloques(lang, X(`empezar.${p}`))} />)}
        </ol>
        <Fragment set:html={botones(X('empezar.botones'), [url(lang, `${PAGINAS.datos}#empezar`)])} />
      </Seccion>

      <!-- 8.9 · Lo que pide, y lo que no hace: la lista literal, en su recuadro discontinuo; ↺ 7 y ↺ 1 al final -->
      <Seccion lang={lang} id="no-hace" prefijo={X('limites')} resto={false} indice>
        <div class="ancho recuadro no-hace">
          <ul>{NO_HACE.map((k) => <li set:html={t(lang, X(`no_hace.${k}`))} />)}</ul>
          <Fragment set:html={botones(X('no_hace.enlace'), [url(lang, `${PAGINAS.datos}#decision-3`)])} />
        </div>
      </Seccion>
    </div>
  </div>
  <BandaCTA lang={lang} />
  <SinSitio lang={lang} prefijo="explorador" usados={[
    'explorador.antetitulo', 'explorador.titulo', 'explorador.entrada', 'explorador.idioma', 'explorador.indice',
    ...S.map((s) => X(s.x)), ...PREGUNTAS.map((p) => X(p)), X('bib'), X('no_hace'), X('img'),
  ]} />
</Base>

<style>
  /* Primera vista: la cabecera en columnas 1–5 y la captura principal en 6–12, alineadas abajo (DESIGN.md § Layout, J). */
  .heroe { width: min(100% - 2 * var(--gutter), var(--ancho)); margin-inline: auto; padding-bottom: clamp(1rem, 3vw, 2rem); }
  .heroe-fecha { font-size: var(--fs-mono-s); margin: .5rem 0 0; }
  @media (min-width: 64rem) {
    .primera-vista {
      display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--col-gap); align-items: end;
      width: min(100% - 2 * var(--gutter), var(--ancho)); margin-inline: auto;
    }
    .primera-vista > :global(.pagina-cabeza) { grid-column: 1 / span 5; width: auto; margin: 0; }
    .heroe { grid-column: 6 / -1; width: auto; margin: 0; padding-block: clamp(3rem, 8vw, 7rem) clamp(2rem, 5vw, 4rem); }
    .heroe :global(.captura figcaption) { max-width: 36rem; }
  }

  .preguntas { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0 var(--col-gap); margin-top: var(--e3); }
  .pregunta :global(h3) { margin: var(--e6) 0 var(--e3); }
  .pregunta :global(p) { max-width: var(--measure); }
  .pregunta :global(.fija) { margin-top: var(--e4); }
  @media (min-width: 48rem) { .preguntas { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .rejilla-capturas, .par-capturas { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--e7) var(--col-gap); margin-block: var(--e6); align-items: start; }
  .rejilla-capturas :global(.captura), .par-capturas :global(.captura) { max-width: none; }
  @media (min-width: 56rem) {
    .rejilla-capturas { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .par-capturas { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    .par-capturas.estrecha-al-lado { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); }
  }
  .ancho > :global(.captura) { margin-block: var(--e6); }

  .recuadro { border: 1px solid var(--hair-2); border-radius: var(--radio); padding: clamp(1rem, 3vw, 1.6rem) clamp(1rem, 3vw, 1.8rem); margin-block: var(--e5); }
  .recuadro ul { margin: 0; padding-left: 1.1rem; max-width: var(--measure); }
  .recuadro li { margin: 0 0 .5em; }
  .recuadro-t { font-weight: 600; margin: 0 0 .6rem; }
  /* «No hace»: trazo discontinuo, lo que la herramienta no trae (DESIGN.md § Shapes). */
  .no-hace { border-style: dashed; }
  .no-hace :global(.botones) { margin-top: var(--e4); }
  .no-hace :global(.fija) { border-top: 1px solid var(--hair); margin: var(--e4) 0 0; padding-top: var(--e3); max-width: var(--measure); }


  .pasos { list-style: none; margin: var(--e4) 0 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--e5) var(--col-gap); counter-reset: paso; }
  .pasos > li { counter-increment: paso; border-top: 1px solid var(--hair-2); padding-top: var(--e3); }
  .pasos > li::before { content: counter(paso); display: block; font: italic 500 var(--fs-cifra)/1 var(--display); color: var(--accent); margin-bottom: var(--e2); }
  .pasos :global(p) { margin: 0; }
  @media (min-width: 56rem) { .pasos { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
