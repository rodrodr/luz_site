---
/**
 * CATÁLOGO DEL SISTEMA (página de trabajo, no se publica). Enseña a los dueños de la fase siguiente cada pieza del
 * andamiaje tal como se ve en el sitio, en los dos temas, con datos y copy REALES: tokens, tipografía, rejilla,
 * movimiento, botones, notas al margen, citas, cifras en frase, registro, fila de datos, consulta y el sistema de
 * figuras (pestañas, nota emergente recorrible y descartable, teclado, tabla y datos).
 *  · Fuera de la publicación: con STRICT=1 no se genera; lleva `noindex` y el mapa del sitio la excluye
 *    (astro.config.mjs). Ninguna página enlaza aquí.
 *  · Ninguna cifra se teclea: salen de `cifras.json` (con su envoltorio) o de `src/data/*.json`; los valores de los
 *    tokens y los contrastes, de `tokens.json`, medidos aquí con la misma fórmula que `scripts/tokens.mjs`.
 *  · Los textos de muestra son claves del copy; lo que explica el catálogo va en español, marcado con su lengua.
 */
import Base from '../../layouts/Base.astro';
import IndiceLateral from '../../components/IndiceLateral.astro';
import Boton from '../../components/Boton.astro';
import NotaMargen from '../../components/NotaMargen.astro';
import Sello from '../../components/Sello.astro';
import CitaDiario from '../../components/CitaDiario.astro';
import CifraFrase from '../../components/CifraFrase.astro';
import FilaDatos from '../../components/FilaDatos.astro';
import RegistroPuertas from '../../components/RegistroPuertas.astro';
import Pestanas from '../../components/Pestanas.astro';
import Cita from '../../components/Cita.astro';
import CopiarConsulta from '../../components/CopiarConsulta.astro';
import Vecinas from '../../components/ficha/Vecinas.astro';
import tokens from '../../styles/tokens.json';
import { t, plano, rotulo, existe } from '../../lib/i18n';
import { fmt, cifra, escapa } from '../../lib/cifras';
import { dato } from '../../lib/datos';
import { citaConjunto, bibtex, ris, huella } from '../../lib/cita';
import { url, PAGINAS, ETAPAS } from '../../lib/rutas';
import { ENLACES } from '../../config/enlaces';
import { LANGS, type Lang } from '../../lib/idiomas';

export function getStaticPaths() {
  // Página de trabajo: la compilación de publicación no la genera.
  if (process.env.STRICT === '1') return [];
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const cat = lang === 'es' ? undefined : 'es'; // el texto propio del catálogo está en español
const o = (k: string) => t(lang, k);

// ── contraste WCAG 2 (la misma fórmula que scripts/tokens.mjs) ───────────────────────────────────────────
const rgba = (c: string) => {
  const hex = c.match(/^#([0-9a-f]{6})$/i);
  if (hex) return [0, 2, 4].map((i) => parseInt(hex[1].slice(i, i + 2), 16)).concat(1);
  const m = c.match(/^rgba?\(([^)]+)\)$/i);
  if (m) { const p = m[1].split(',').map((x) => Number(x.trim())); return [p[0], p[1], p[2], p[3] ?? 1]; }
  return null;
};
const lin = (v: number) => { v /= 255; return v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4; };
const lum = (c: number[]) => 0.2126 * lin(c[0]) + 0.7152 * lin(c[1]) + 0.0722 * lin(c[2]);
function contraste(a: string, b: string): number | null {
  const fa = rgba(a), fb = rgba(b);
  if (!fa || !fb) return null;
  const A = fa[3] < 1 ? [0, 1, 2].map((i) => fa[i] * fa[3] + fb[i] * (1 - fa[3])) : fa;
  const [l1, l2] = [lum(A), lum(fb)].sort((x, y) => y - x);
  return (l1 + 0.05) / (l2 + 0.05);
}
const T = tokens.temas as Record<'oscuro' | 'claro', Record<string, string>>;
const dec2 = (x: number) => x.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const PARES = [
  ...tokens.contrastes.texto.map(([a, b]) => ({ a, b, min: 4.5, clase: 'texto' })),
  ...tokens.contrastes.grafico.map(([a, b]) => ({ a, b, min: 3, clase: 'gráfico' })),
].map((p) => ({ ...p, oscuro: contraste(T.oscuro[p.a], T.oscuro[p.b]) ?? 0, claro: contraste(T.claro[p.a], T.claro[p.b]) ?? 0 }));

const NEUTROS = ['bg', 'bg-2', 'bg-3', 'ink', 'ink-2', 'mute', 'hair', 'hair-2'];
const ACENTO = ['accent', 'accent-ink', 'accent-inv', 'focus'];
const DATOS = ['rampa-0', 'rampa-1', 'rampa-2', 'rampa-3', 'rampa-4', 'ausencia-trazo', 'dato', 'dato-2'];
const IDEO = ['ei', 'i', 'ci', 'c', 'cd', 'd', 'ed', 'nc'];

const ESCALA = [
  { tk: '--fs-portada', uso: 'H1 de Inicio', clase: 'm-portada', texto: o('inicio.portada.pregunta') },
  { tk: '--fs-h1', uso: 'H1 de página y nombre de etapa', clase: 'm-h1', texto: o('comun.etapa.I.nombre') },
  { tk: '--fs-h2', uso: 'H2 de sección, casi siempre una pregunta', clase: 'm-h2', texto: o('inicio.fila.titulo') },
  { tk: '--fs-h3', uso: 'H3 de los apartados largos (EB Garamond 600)', clase: 'm-h3', texto: o('inicio.falta.titulo') },
  { tk: '--fs-entrada', uso: 'la frase grande bajo cada H2', clase: 'm-entrada', texto: o('inicio.portada.entrada') },
  { tk: '--fs-cita', uso: 'lo que alguien dijo (cursiva de libro)', clase: 'm-cita', texto: o('inicio.fila.campoamor') },
  { tk: '--fs-body', uso: 'cuerpo de lectura, medida de 38 rem', clase: 'm-body', texto: o('inicio.fila.dos') },
  { tk: '--fs-small', uso: 'notas al margen, pies y salvedades', clase: 'm-nota', texto: o('comun.fija.diario') },
  { tk: '--fs-cifra', uso: 'la cifra grande, dentro de su frase', clase: 'm-cifra', texto: fmt.clave('sesiones', lang) },
  { tk: '--fs-grito', uso: 'solo «Luz y taquígrafos.», en la banda de Inicio', clase: 'm-grito', texto: o('inicio.nombre.grito') },
];

// La muestra de figura: las sesiones de cada etapa (cifras.json › etapa.<E>.sesiones, V2).
const barras = ETAPAS.map((e) => {
  const c = cifra(`etapa.${e.id}.sesiones`);
  return { id: e.id, slug: e.slug, v: typeof c?.v === 'number' ? c.v : 0, f: c?.f ?? '', nombre: plano(lang, `comun.etapa.${e.id}.nombre`), corto: plano(lang, `comun.etapa.${e.id}.corto`), anos: plano(lang, `comun.etapa.${e.id}.anos`) };
});
const maximo = Math.max(1, ...barras.map((b) => b.v));
const h = huella('V2');

// Una sesión real para la fila de datos: la 48 (1-X-1931), la de «¿Qué es una fila?».
interface Ses { clave: string; f: string; s: number; e: string; filas: number; pal: number; dip: number; largas: number; filas_pres: number; id_v2: [number, number]; filas_v3: number; id_v3: [number, number]; meta?: { num?: number; paginas?: [number, number] } }
const S = (dato<{ sesiones: Ses[] }>('sesiones')?.sesiones ?? []).find((x) => x.clave === '1931-10-01-48');
const d = (v: number, campo: string, base: string, formato: 'n' | 'id' = 'n') =>
  fmt.dato(v, formato === 'id' ? fmt.id(v, lang) : fmt.n(v, lang), `sesion.1931-10-01-48.${campo}`, base);
const pares = S ? [
  { columna: 'f', valor: `<code>${S.f}</code>` },
  { columna: 's', valor: d(S.s, 'num', 'V2', 'id') },
  { columna: 'filas', valor: d(S.filas, 'filas', 'V2') },
  { columna: 'pal', valor: d(S.pal, 'palabras', 'V2') },
  { columna: 'dip', valor: d(S.dip, 'diputados', 'V2') },
  { columna: 'filas_pres', valor: d(S.filas_pres, 'filas_pres', 'V2') },
  { columna: 'id_v2', valor: `${d(S.id_v2[0], 'id_v2.desde', 'V2', 'id')}–${d(S.id_v2[1], 'id_v2.hasta', 'V2', 'id')}` },
  { columna: 'id_v3', valor: `${d(S.id_v3[0], 'id_v3.desde', 'v3', 'id')}–${d(S.id_v3[1], 'id_v3.hasta', 'v3', 'id')}` },
  { columna: 'speech (de otra pieza: Campoamor, en esa sesión)', valor: o('inicio.fila.campoamor'), texto: true },
] : [];

const pie = (k: string) => { const p = t(lang, k); const i = p.indexOf(' · '); return i > 0 ? { orador: p.slice(0, i), asiento: p.slice(i + 3) } : { orador: '', asiento: p }; };
const presi = pie('inicio.fila.presidencia.pie');
const campo = pie('inicio.fila.campoamor.pie');

const SECCIONES = [
  { id: 'tokens', rotulo: 'Color y contraste' },
  { id: 'tipografia', rotulo: 'Tipografía' },
  { id: 'rejilla', rotulo: 'Rejilla y ritmo' },
  { id: 'botones', rotulo: 'Enlaces y botones' },
  { id: 'margen', rotulo: 'Asiento y notas al margen', sub: [{ id: 'sellos', rotulo: 'Sellos de fuente' }] },
  { id: 'citas', rotulo: 'Citas del Diario', sub: [{ id: 'pasaje', rotulo: 'Pasaje del pintor genérico' }, { id: 'cita-copiable', rotulo: 'Cita copiable' }] },
  { id: 'cifras', rotulo: 'Cifras en frase' },
  { id: 'registro', rotulo: 'Registro y fila de datos' },
  { id: 'consulta', rotulo: 'Consulta para el explorador' },
  { id: 'figura', rotulo: 'Sistema de figuras' },
  { id: 'movimiento', rotulo: 'Movimiento' },
];
---
<Base lang={lang} ruta="componentes" titulo="Catálogo del sistema" descripcion="Página de trabajo: cada pieza del andamiaje de Luz y Taquígrafos, en los dos temas, con datos y copy reales." noindex>
  <header class="pagina-cabeza contenedor" lang={cat} data-audit-exento="catálogo: página de trabajo, fuera de la publicación">
    <p class="miga"><a href={url(lang)}>{plano(lang, 'comun.cabecera.nombre')}</a> / catálogo · página de trabajo, fuera de la publicación</p>
    <h1>El sistema, pieza a pieza</h1>
    <p class="entrada">Cada componente del andamiaje, con datos y copy reales, tal como lo verá el lector. Norma: <code>DESIGN.md</code>, «El Diario, anotado al margen».</p>
    <p class="asiento">tokens <code>src/styles/tokens.json</code> · estilos <code>base.css</code>, <code>figuras.css</code>, <code>piezas.css</code>, <code>movimiento.css</code> · isla <code>scripts/figuras.ts</code></p>
  </header>

  <div class="contenedor con-indice" lang={cat} data-audit-exento="catálogo: página de trabajo, fuera de la publicación" style={`timeline-scope: ${SECCIONES.map((x) => `--${x.id}`).join(', ')}`}>
    <IndiceLateral lang={lang} titulo="En esta página" entradas={SECCIONES} />
    <div class="lectura">

      <!-- ── 01 · Color ─────────────────────────────────────────────────────────── -->
      <section class="seccion" id="tokens" aria-labelledby="tokens-titulo" style="view-timeline-name: --tokens" data-audit-exento="catálogo: valores de los tokens">
        <div class="seccion-cuerpo">
          <p class="asiento">tokens.json › temas · generado en <code>tokens.css</code> por <code>scripts/tokens.mjs</code></p>
          <h2 id="tokens-titulo">¿De qué color es cada cosa?</h2>
          <p class="entrada">Dos neutros cálidos que se recalculan por tema, un oro que anota y un azul que solo señala el foco.</p>
          <div class="cat-ancho">
            {[['Neutros', NEUTROS], ['Oro y foco', ACENTO], ['Datos: rampa y ausencia', DATOS], ['Ideología (solo F09, F26 con nombres y F21)', IDEO]].map(([titulo, lista]) => (
              <div class="paleta">
                <h3>{titulo as string}</h3>
                <table class="fig-tabla tabla-tokens">
                  <thead><tr><th scope="col">token</th><th scope="col">oscuro</th><th scope="col">claro</th></tr></thead>
                  <tbody>
                    {(lista as string[]).map((k) => (
                      <tr>
                        <th scope="row"><code>--{k}</code></th>
                        <td><span class="chip" style={`background:${T.oscuro[k]}`} aria-hidden="true"></span><code>{T.oscuro[k]}</code></td>
                        <td><span class="chip" style={`background:${T.claro[k]}`} aria-hidden="true"></span><code>{T.claro[k]}</code></td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ))}
          </div>
          <NotaMargen asiento="WCAG 2.2 · 4,5:1 texto · 3:1 gráfico">
            <p>El claro no invierte: cada color conserva matiz y croma y baja de luminosidad hasta el contraste exigido. <code>apagado</code> nunca va sobre <code>--bg-3</code>.</p>
          </NotaMargen>
          <div class="cat-ancho">
            <h3>Contrastes medidos en cada tema</h3>
            <div class="fig-desliza" tabindex="0" role="region" aria-label="Contrastes medidos">
              <table class="fig-tabla">
                <thead><tr><th scope="col">par</th><th scope="col">clase</th><th scope="col" class="num">oscuro</th><th scope="col" class="num">claro</th><th scope="col" class="num">mínimo</th></tr></thead>
                <tbody>
                  {PARES.map((p) => (
                    <tr>
                      <th scope="row"><code>{p.a}</code> / <code>{p.b}</code></th>
                      <td>{p.clase}</td>
                      <td class="num" data-cumple={p.oscuro >= p.min ? 'si' : 'no'}><code>{dec2(p.oscuro)}</code></td>
                      <td class="num" data-cumple={p.claro >= p.min ? 'si' : 'no'}><code>{dec2(p.claro)}</code></td>
                      <td class="num"><code>{dec2(p.min)}</code></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

      <!-- ── 02 · Tipografía ────────────────────────────────────────────────────── -->
      <section class="seccion" id="tipografia" aria-labelledby="tipografia-titulo" style="view-timeline-name: --tipografia">
        <div class="seccion-cuerpo">
          <p class="asiento">Cormorant Garamond cursiva · EB Garamond · JetBrains Mono · <code>latin</code> y <code>latin-ext</code>, autoalojadas</p>
          <h2 id="tipografia-titulo">¿Quién habla con cada letra?</h2>
          <p class="entrada">La cursiva de titular es la voz del sitio; la garamond de libro, la lectura; su cursiva, lo que alguien dijo; la mono, lo que se copia o se compara.</p>
          <ol class="escala cat-ancho" role="list">
            {ESCALA.map((e) => (
              <li>
                <p class="escala-tk"><code>{e.tk}</code> · {e.uso}</p>
                <p class:list={['escala-m', e.clase]} set:html={e.texto} />
              </li>
            ))}
            <li>
              <p class="escala-tk"><code>.asiento</code> · la línea de registro: un hecho con su base, en caja normal y en gris; nunca una etiqueta</p>
              <p class="asiento"><Fragment set:html={fmt.clave('sesiones', lang)} /> sesiones · <Fragment set:html={fmt.clave('sesion.primera', lang, 'fecha_corta')} /> → <Fragment set:html={fmt.clave('sesion.ultima', lang, 'fecha_corta')} /></p>
            </li>
            <li>
              <p class="escala-tk"><code>.versal</code> · versalitas simuladas (el woff2 no trae <code>smcp</code>): el orador y la Presidencia</p>
              <p><span class="versal" set:html={campo.orador} /></p>
            </li>
          </ol>
          <NotaMargen asiento="la regla de la cursiva">
            <p>En la garamond de lectura, la cursiva es para lo que alguien dijo. El énfasis se hace con peso 600, nunca con cursiva.</p>
          </NotaMargen>
        </div>
      </section>

      <!-- ── 03 · Rejilla ───────────────────────────────────────────────────────── -->
      <section class="seccion" id="rejilla" aria-labelledby="rejilla-titulo" style="view-timeline-name: --rejilla" data-audit-exento="catálogo: medidas de los tokens">
        <div class="seccion-cuerpo">
          <p class="asiento">12 columnas desde <code>64rem</code> · una por debajo · ancho <code>{tokens.medidas.ancho}</code> · medida <code>{tokens.medidas.measure}</code></p>
          <h2 id="rejilla-titulo">¿Cuánto aire hay entre las cosas?</h2>
          <p class="entrada">Base de 4 px y una escala con nombre. Encima de un título, siempre más aire que debajo.</p>
          <div class="cat-ancho">
            <div class="columnas" aria-hidden="true">{Array.from({ length: 12 }, () => <span></span>)}</div>
            <ol class="espacios" role="list">
              {['e1', 'e2', 'e3', 'e4', 'e5', 'e6', 'e7', 'e8', 'e9'].map((k) => (
                <li><code>--{k}</code><span class="barra-e" style={`width: var(--${k})`}></span><code>{(tokens.medidas as Record<string, string>)[k]}</code></li>
              ))}
              <li><code>--aire</code><span class="barra-e aire" style="width: var(--aire)"></span><code>{tokens.medidas.aire}</code></li>
            </ol>
          </div>
          <NotaMargen asiento="la asimetría, solo en escritorio">
            <p>Las notas siguen a su bloque en el DOM; la colocación automática las sube a su fila en escritorio y en el móvil van detrás.</p>
          </NotaMargen>
        </div>
      </section>

      <!-- ── 04 · Botones ───────────────────────────────────────────────────────── -->
      <section class="seccion" id="botones" aria-labelledby="botones-titulo" style="view-timeline-name: --botones">
        <div class="seccion-cuerpo">
          <p class="asiento"><code>Boton.astro</code> · <code>.boton</code> · <code>.boton.sec</code> · 44 px de alto · EB Garamond 560</p>
          <h2 id="botones-titulo">¿Cómo se ve lo que se pulsa?</h2>
          <p>Un enlace en la prosa lleva el <a href={url(lang, PAGINAS.metodo)}>subrayado en oro</a>: el oro subraya y no tiñe el texto de lectura. Al pasar el puntero, el texto va en oro y el trazo engorda.</p>
          <div class="botones cat-ancho">
            <Boton variante="primario" href={url(lang, `${PAGINAS.datos}#empezar`)} rotulo={rotulo(lang, 'comun.boton.descargar')} />
            <Boton href={url(lang, PAGINAS.metodo)} rotulo={rotulo(lang, 'comun.boton.ver_metodo')} />
            <Boton href={ENLACES.explorador} externo rotulo={rotulo(lang, 'comun.boton.explorador')} />
          </div>
          <div class="cat-ancho copia-demo" data-copiable>
            <p class="asiento">copiar · nace oculto sin JS · «Copiada» durante 1,6 s</p>
            <code class="consulta-texto" data-copiar-texto translate="no">{plano(lang, 'comun.fija.diario')}</code>
            <p class="botones">
              <Boton copiar rotulo={rotulo(lang, 'comun.boton.cita')} />
              <span class="consulta-aviso" role="status" data-copiar-aviso data-copiada={plano(lang, 'comun.cita.copiada')} data-no-copiada={plano(lang, 'comun.isla.no_copiado')}></span>
            </p>
          </div>
          <NotaMargen asiento="uno por pantalla">
            <p>Un solo primario por pantalla. El externo lleva la flecha dibujada y lo dice al lector de pantalla; nunca el carácter.</p>
          </NotaMargen>
        </div>
      </section>

      <!-- ── 05 · Margen ────────────────────────────────────────────────────────── -->
      <section class="seccion" id="margen" aria-labelledby="margen-titulo" style="view-timeline-name: --margen">
        <div class="seccion-cuerpo">
          <p class="asiento"><code>NotaMargen.astro</code> · <code>.al-margen</code> (secciones) · <code>.nota-m</code> (lecturas) · ≤ 40 palabras</p>
          <h2 id="margen-titulo">¿Dónde va la costura?</h2>
          <p><Fragment set:html={t(lang, 'inicio.fila.dos')} /><sup class="llamada-n">1</sup> <Fragment set:html={t(lang, 'inicio.fila.leccion')} /></p>
          <NotaMargen n="1" asiento={`${fmt.clave('filas.V2', lang)} filas`}>
            <p set:html={t(lang, 'comun.fija.diario')} />
          </NotaMargen>
          <h3 id="sellos">Sellos de fuente</h3>
          <p>Solo para lo que no es la base: los metadatos del proyecto, Afinidades Elegidas, Dataverse, el explorador y el croquis. La base no lleva sello ni nombra ediciones.</p>
          <p class="sellos-demo">
            {(['proyecto', 'afin', 'dv', 'explorador', 'croquis'] as const).map((b) => existe(`comun.sello.${b}`) && <Sello lang={lang} base={b} />)}
          </p>
        </div>
      </section>

      <!-- ── 06 · Citas ─────────────────────────────────────────────────────────── -->
      <section class="seccion" id="citas" aria-labelledby="citas-titulo" style="view-timeline-name: --citas">
        <div class="seccion-cuerpo">
          <p class="asiento"><code>CitaDiario.astro</code> · orador en versalitas · cita en cursiva de libro · comilla colgada DENTRO de su caja</p>
          <h2 id="citas-titulo">¿Cómo se compone lo que alguien dijo?</h2>
          <CitaDiario orador={campo.orador} cita={t(lang, 'inicio.fila.campoamor')} asiento={campo.asiento} presidencia={{ orador: presi.orador, cita: t(lang, 'inicio.fila.presidencia') }} />
          <NotaMargen asiento="sin invadir el margen">
            <p>La comilla de apertura queda en el borde de la columna y las letras, alineadas con el orador y el asiento. A 360 px no se come los 16 px del margen de la página.</p>
          </NotaMargen>
          <h3 id="pasaje">Pasaje del pintor genérico</h3>
          <div class="pasaje" data-audit-exento="cita literal del Diario"><p set:html={t(lang, 'diario.que_es.cita.interrupcion')} /></div>
          <div class="pieza-nota" data-audit-exento="cita literal del Diario"><p set:html={t(lang, 'diario.que_es.cita.interrupcion.pie')} /></div>
          <h3 id="cita-copiable">Cita copiable</h3>
          <Cita lang={lang} texto={citaConjunto('thqcmi', lang)} bibtex={bibtex('thqcmi')} ris={ris('thqcmi')} lenguaTexto="en" nota={existe('comun.cita.dataverse') ? t(lang, 'comun.cita.dataverse') : undefined} />
        </div>
      </section>

      <!-- ── 07 · Cifras en frase ───────────────────────────────────────────────── -->
      <section class="seccion" id="cifras" aria-labelledby="cifras-titulo" style="view-timeline-name: --cifras">
        <div class="seccion-cuerpo">
