---
/**
 * A · Inicio · REDISEÑO del 23-09-2026 (docs/REDISENO_23-09.md; decisiones 1–5 del investigador y su petición: gráficos
 * interactivos y atractivos, que se manipulan y se juegan). La versión anterior está en la etiqueta
 * `v0.1-antes-del-rediseno` (commit 240b401).
 *
 * Siete bloques, una idea, una figura y una acción cada uno; ni «V2» ni «v3» (las cifras son de la edición depositada y
 * las redondas valen en las dos: formato `|redondo`); las salvedades viven en Método.
 *   0 portada: la pregunta, el hemiciclo de 1936 (la Cámara se sienta) y la credencial
 *   1 el nombre: «Luz y taquígrafos.» (la única banda invertida)
 *   2 más que una base de datos: las seis piezas de la infraestructura
 *   3 juego 1 · ¿Cuándo se habló de…? (laboratorio de palabras + calendario + los ocho momentos)
 *   4 juego 2 · ¿Cuántos votaron sí? (seis votaciones nominales para apostar)
 *   5 juego 3 · ¿Con quién firmaba cada diputado? (F21 de Afinidades, en escaparate)
 *   6 empiece hoy: la escalera, la cita y el remate (D-24)
 * Copy: `inicio.*` (docs/copy_es/inicio.md). Las claves `inicio.{puertas,f26,f01c,falta,fila}.*` las leen otras páginas.
 */
import Base from '../../layouts/Base.astro';
import Hemiciclo from '../../components/Hemiciclo.astro';
import Laboratorio from '../../components/inicio/Laboratorio.astro';
import Apuesta from '../../components/inicio/Apuesta.astro';
import FigRed from '../../components/FigRed.astro';
import Salidas from '../../components/Salidas.astro';
import Cita from '../../components/Cita.astro';
import SinSitio from '../../components/SinSitio.astro';
import { t, tEnlaces, existe, rotulo } from '../../lib/i18n';
import { marcaPendiente } from '../../lib/cifras';
import { meta } from '../../lib/pagina';
import { url, PAGINAS } from '../../lib/rutas';
import { ENLACES } from '../../config/enlaces';
import { remata } from '../../lib/remata';
import { citaConjunto, bibtex, ris, jsonldDe } from '../../lib/cita';
import { rutasPorIdioma, type Lang } from '../../lib/idiomas';

export const getStaticPaths = rutasPorIdioma;
const lang = Astro.params.lang as Lang;
const { titulo, descripcion } = meta(lang, 'inicio');
const o = (k: string) => (existe(k) ? t(lang, k) : marcaPendiente(k, 'copy'));
// Un solo botón primario por pantalla: «Abrir el explorador», en oro y delante (decisión 2 del 23-09-2026).
const DATOS_EMPEZAR = url(lang, `${PAGINAS.datos}#empezar`);
const rotulosPortada = [...t(lang, 'inicio.portada.llamada').matchAll(/(?<!⟦)\[([^\]⟦⟧]+)\](?!⟧)/g)].map((m) => m[1]);
const aExplorador = (r: string) => /explor/i.test(r);
const llamadaPortada = (remata(tEnlaces(lang, 'inicio.portada.llamada', rotulosPortada.map((r) => (aExplorador(r) ? ENLACES.explorador : DATOS_EMPEZAR)), {}, 'boton'))
  .match(/<a\b[\s\S]*?<\/a>/g) ?? [])
  .map((a) => (a.includes(`href="${ENLACES.explorador}`) ? { a, primero: 0 } : { a: a.replace('class="boton"', 'class="boton sec"'), primero: 1 }))
  .sort((x, y) => x.primero - y.primero)
  .map((x) => x.a)
  .join(' ');
const PIEZAS = ['diario', 'fila', 'orador', 'explorador', 'redes', 'abierto'];
const PELDANOS = ['sin_programar', 'programar', 'redes'];
---
<Base lang={lang} ruta={PAGINAS.inicio} titulo={titulo} descripcion={descripcion} jsonld={jsonldDe('thqcmi', lang)} esInicio>
  <!-- 0 · Portada: la pregunta y el hemiciclo de 1936. La Cámara se sienta (CSS, 0 KB de JS). -->
  <section class="portada" aria-labelledby="portada-titulo">
    <div class="contenedor rejilla">
      <div class="portada-texto">
        <h1 id="portada-titulo" set:html={o('inicio.portada.pregunta')} />
        <p class="entrada" set:html={o('inicio.portada.entrada')} />
        <p class="botones" set:html={llamadaPortada} />
        <p class="credencial" set:html={o('inicio.credencial')} />
      </div>
      <div class="portada-fig">
        <Hemiciclo lang={lang} />
      </div>
    </div>
  </section>

  <!-- 1 · El nombre: la ÚNICA banda invertida del sitio. -->
  <section class="banda" aria-labelledby="banda-grito">
    <div class="contenedor rejilla">
      <blockquote class="grito cita-diario" id="banda-grito"><p set:html={o('inicio.nombre.grito')} /></blockquote>
      <p class="banda-texto" set:html={o('inicio.nombre.texto')} />
    </div>
  </section>

  <!-- 2 · Más que una base de datos: las seis piezas de la infraestructura. -->
  <section class="piezas" aria-labelledby="piezas-titulo">
    <div class="contenedor">
      <h2 id="piezas-titulo" set:html={o('inicio.piezas.titulo')} />
      <p class="entrada" set:html={o('inicio.piezas.entrada')} />
      <ol class="piezas-lista" role="list">
        {PIEZAS.map((k) => <li set:html={o(`inicio.piezas.${k}`)} />)}
      </ol>
    </div>
  </section>

  <!-- 3 · Juego 1: ¿Cuándo se habló de…? -->
  <Laboratorio lang={lang} />

  <!-- 4 · Juego 2: ¿Cuántos votaron sí? -->
  <Apuesta lang={lang} />

  <!-- 5 · Juego 3: la red de las firmas (F21 de Afinidades, en escaparate). -->
  <section class="red" aria-labelledby="red-titulo">
    <div class="contenedor">
      <h2 id="red-titulo" set:html={o('inicio.red.titulo')} />
      <p class="entrada" set:html={o('inicio.red.entrada')} />
      <FigRed lang={lang} escaparate />
      <p class="botones"><a class="boton sec" href={url(lang, PAGINAS.afinidades)} set:html={rotulo(lang, 'comun.boton.ver_afinidades')} /></p>
    </div>
  </section>

  <!-- 6 · Empiece hoy: la escalera, la cita y el remate. -->
  <section class="empezar" aria-labelledby="empezar-titulo">
    <div class="contenedor">
      <h2 id="empezar-titulo" set:html={o('inicio.empezar.titulo')} />
      <Salidas lang={lang} prefijo="inicio.empezar" peldanos={PELDANOS} primario="sin_programar" />
      <Cita lang={lang} texto={citaConjunto('thqcmi', lang)} bibtex={bibtex('thqcmi')} ris={ris('thqcmi')} lenguaTexto="en" nota={existe('comun.cita.dataverse') ? t(lang, 'comun.cita.dataverse') : undefined} />
      <p class="remate" set:html={o('inicio.empezar.remate')} />
    </div>
  </section>

  <SinSitio lang={lang} prefijo="inicio" usados={['inicio.meta', 'inicio.portada', 'inicio.credencial', 'inicio.nombre', 'inicio.piezas', 'inicio.lab', 'inicio.apuesta', 'inicio.red', 'inicio.empezar']} ignorar={['puertas', 'f26', 'f01c', 'falta', 'fila']} />
</Base>

<style>
  /* Menos aire que en la 0.1 (hasta 16 rem entre secciones): cada bloque respira por su propio relleno. */
  section:not(.portada):not(.banda) { padding-block: clamp(2.5rem, 4.5vw, 4.5rem); }
  section h2 { font: italic 500 var(--fs-h2)/1.05 var(--display); margin: 0 0 var(--e4); max-width: 22ch; text-wrap: balance; }
  section .entrada { color: var(--ink-2); max-width: 40rem; margin: 0 0 var(--e5); }

  .portada { padding-block: clamp(2.5rem, 5vw, 4.5rem) clamp(2rem, 5vw, 4rem); }
  .portada .rejilla { align-items: start; row-gap: var(--e6); }
  .portada-texto h1 { font-size: var(--fs-portada); line-height: 1; max-width: 13.5ch; text-wrap: balance; }
  .portada-texto .entrada { margin-top: var(--e5); }
  .credencial { margin: var(--e4) 0 0; font: 400 var(--fs-mono-s)/1.6 var(--mono); color: var(--mute); overflow-wrap: anywhere; }
  @media (min-width: 64rem) {
    .portada-texto { grid-column: 1 / span 5; padding-top: var(--e7); }
    .portada-fig { grid-column: 6 / -1; }
  }
  /* La leyenda del hemiciclo, plegada en sus cuatro bloques: las minorías de un bloque aparecen al elegirlo. */
  .portada :global(.leg-bloque > ul) { display: none; }
  .portada :global(.hemi-leyenda:has(input[value='der']:checked) .leg-bloque[data-b='der'] > ul),
  .portada :global(.hemi-leyenda:has(input[value='cen']:checked) .leg-bloque[data-b='cen'] > ul),
  .portada :global(.hemi-leyenda:has(input[value='izq']:checked) .leg-bloque[data-b='izq'] > ul),
  .portada :global(.hemi-leyenda:has(input[value='gob']:checked) .leg-bloque[data-b='gob'] > ul) { display: block; margin-top: .4rem; }

  /* 1 · la banda invertida: tinta de fondo, fondo de texto y el oro invertido. */
  .banda { background: var(--ink); color: var(--bg); padding-block: clamp(3.5rem, 7vw, 7rem); --accent: var(--accent-inv); }
  .grito p { font: italic 500 var(--fs-grito)/.98 var(--display); letter-spacing: -.02em; margin: 0 0 var(--e5); max-width: none; }
  .banda-texto { font-size: var(--fs-entrada); line-height: 1.4; max-width: 38rem; margin: 0; }
  @media (min-width: 64rem) {
    .banda .grito { grid-column: 1 / -1; }
    .banda-texto { grid-column: 4 / span 7; }
  }

  /* 2 · las seis piezas: tipografía y filete, sin tarjetas ni iconos (DESIGN.md). */
  .piezas-lista { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--e5) var(--e6); grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); counter-reset: pieza; }
  .piezas-lista li { counter-increment: pieza; border-top: 1px solid var(--hair-2); padding-top: var(--e3); font: 400 var(--fs-body)/1.45 var(--text); color: var(--ink-2); }
  .piezas-lista li::before { content: counter(pieza, upper-roman); display: block; font: italic 500 1.5rem/1 var(--display); color: var(--accent); margin-bottom: var(--e2); }
  .piezas-lista li :global(strong) { display: block; font: 600 var(--fs-body)/1.3 var(--text); color: var(--ink); margin-bottom: .2rem; }

  /* 5 · la red */
  .red .botones { margin-top: var(--e5); }
  .red :global(.fig-barra-sola) { margin: 0 0 var(--e4); }
  .red :global(.f21-cuenta), .red :global(.f21-grafia) { display: none !important; }

  /* 6 · empiece hoy */
  .remate { margin: var(--e6) 0 0; font: italic 500 var(--fs-h3)/1.2 var(--display); color: var(--accent); }
</style>
